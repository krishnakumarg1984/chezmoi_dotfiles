# vim: ft=nanorc:
# https://github.com/davidhcefx/Modern-Nano-Keybindings

# Auto indent (Use auto-indentation.)
set autoindent

# Back up edited files as <file_name>~
# set backup

# Backup directory
#set backupdir ""

# Do backwards searches by default.
# set backwards

# Perform case-sensitive searches
# set casesensitive

# Make use of blank line below title bar
# Use the blank line below the titlebar as extra editing space.
# set morespace

# Allow the opening of multiple files (use ctrl+r)
# This can be toggled with alt+f
# Swap buffers with alt+, (reverse) and alt+. (forward)
set multibuffer

## Set operating directory.  nano will not read or write files outside
## this directory and its subdirectories.  Also, the current directory
## is changed to here, so any files are inserted from this dir.  A blank
## string means the operating-directory feature is turned off.
# set operatingdir ""

## Make the justify command kill whitespace at the end of lines.
# set justifytrim

## Set the line length for wrapping text and justifying paragraphs.
## If the value is 0 or less, the wrapping point will be the screen
## width less this number.
# set fill -8

# The characters treated as closing punctuation when justifying paragraphs.
# They cannot contain blank characters.  Only closing punctuation, optionally
# followed by closing brackets, can end sentences.
# set punct "!.?"

# Do quick statusbar blanking.  Statusbar messages will disappear after
# 1 keystroke instead of 26.  Note that "const" overrides this.
set quickblank

# Display cursor position in the status bar
# "const" has been deprecated since nano 2.9.7. Use "constantshow" in nano >=2.9.7.
# Constantly display the cursor position in the statusbar.  Note that
# this overrides "quickblank".
#set const
set constantshow

## Use cut-to-end-of-line by default. Use cut-from-cursor-to-end-of-line by default, instead of cutting the whole line.
set cutfromcursor

# Omit the helpful shortcut list at the bottom of the screen for more editing space
# set nohelp

# Do not wrap text
set nowrap

## Enable soft line wrapping (AKA full-line display).
set softwrap

# When soft line wrapping is enabled, make it wrap lines at blank characters (tabs and spaces) instead of always at the edge of the screen.
set atblanks

# Ignore XON and XOFF (^Q and ^S) keys
unset preserve

# Perform extended regular expression searches
# Do extended regular expression searches by default.
set regexp

# Use smooth scrolling (single line)
# set smooth

# Use the following spelling checker
# Use this spelling checker instead of the internal one.  This option
# does not properly have a default value.
# set speller "hunspell"
set speller "aspell -x -c"

# Allow nano to be suspended (ctrl+z and then "fg" from the shell to resume)
# set suspend

# Tab size is equal to *this* many spaces (Use this tab size instead of the default; it must be greater than 0.)
set tabsize 2

# Convert typed tabs to spaces
set tabstospaces

## Save automatically on exit; don't prompt.
# set tempfile

## Disallow file modification.  Why would you want this in an rcfile? ;)
# set view

## The two single-column characters used to display the first characters
## of tabs and spaces.  187 in ISO 8859-1 (0000BB in Unicode) and 183 in
## ISO-8859-1 (0000B7 in Unicode) seem to be good values for these.
## The default when in a UTF-8 locale:
# set whitespace "»·"
## The default otherwise:
# set whitespace ">."

# Keybinds
#bind M-W nowrap main
#bind M-A casesens search
#bind ^S research main
#bind kdel backspace all

set linenumbers

# Enable vim-style lock-files.  This is just to let a vim user know you
# are editing a file [s]he is trying to edit and vice versa. There are
# no plans to implement vim-style undo state in these files.
set locking

set numbercolor yellow,normal
## Paint the interface elements of nano.
## These are examples; by default there are no colors.
# set titlecolor brightwhite,blue
# set numbercolor cyan
# set statuscolor brightwhite,green
# set keycolor green
# set functioncolor yellow

# Enable mouse support, if available for your system.  When enabled, mouse
# clicks can be used to place the cursor, set the mark (with a double click),
# and execute shortcuts. The mouse will work in the X Window System, and on the
# console when gpm is running.
set mouse

## Fix numeric keypad key confusion problem.
# set rebindkeypad

# `Home` jumps to line start first
# Make the Home key smarter.  When Home is pressed anywhere but at the
# very beginning of non-whitespace characters on a line, the cursor
# will jump to that beginning (either forwards or backwards).  If the
# cursor is already at that position, it will jump to the true
# beginning of the line.
set smarthome

# delete selected text as a whole. Let an unmodified Backspace or Delete erase the marked region (instead of a single character, and without affecting the cutbuffer).
set zap

# `Ctrl+Right` move to word ends instead of word starts
set afterends

# recognize '_' as part of a word
# The characters (besides alphanumeric ones) that should be considered
# as parts of words.  This option does not have a default value.  When
# set, it overrides option 'set wordbounds'.
set wordchars "_"
# set wordchars "<_>."

# remember search history (Remember the used search/replace strings for the next session.)
# Save the last hundred search strings and replacement strings and executed commands, so they can be easily reused in later sessions.
set historylog

## The email-quote string, used to justify email-quoted paragraphs.
## This is an extended regular expression if your system supports them,
## otherwise a literal string.
## If you have extended regular expression support, the default is:
# set quotestr "^([ 	]*[#:>\|}])+"
## Otherwise:
# set quotestr "> "
# set quotestr "^([ 	]*([!#%:;>|}]|//))+"

# The opening and closing brackets that can be found by bracket
# searches.  They cannot contain blank characters.  The former set must
# come before the latter set, and both must be in the same order.
# set matchbrackets "(<[{)>]}"

## The characters treated as closing brackets when justifying
## paragraphs.  They cannot contain blank characters.  Only closing
## punctuation, optionally followed by closing brackets, can end
## sentences.
# set brackets ""')>]}"

# Remember the cursor position in each file for the next editing session.
set positionlog

# Put the cursor on the highlighted item in the file browser;
# useful for people who use a braille display.
set showcursor

# Use bold text instead of reverse video text.
# set boldtext

# Don't add newlines to the ends of files.
set nonewlines

## Detect word boundaries differently by treating punctuation
## characters as parts of words.
set wordbounds

# Draw a vertical stripe at the given column, to help judge the width of the text.  (The color of the stripe can be changed with set stripecolor.)
set guidestripe 120

# Remove trailing whitespace from wrapped lines when automatic hard-wrapping occurs or when text is justified.
set trimblanks

# Set global syntax
# extendsyntax python tabgives "    "
# extendsyntax Makefile tabgives "	"
