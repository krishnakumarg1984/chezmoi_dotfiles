# pretty (((
[pretty]
    concise = "%C(yellow)%h%Creset %C(green)[%ar]%Creset %C(auto)%d%Creset %s %C(cyan)<%an>"
    detail = "%C(auto)%h %s%n  %C(yellow)by %C(blue)%an %C(magenta)<%ae> [%G?] %C(green)%ad%n %C(auto)%d%n"
    line = "%C(auto)%h %<|(60,trunc)%s %C(green)%ad%C(auto)%d"
# pretty )))
# pull (((
[pull]
    ff = only # Only allow pull if it can be fast-forwarded (otherwise you explicitly need to merge in the remote or rebase onto it e.g. with git pull --rebase)
    rebase = true # Only allow pull if it can be fast-forwarded (otherwise you explicitly need to merge in the remote or rebase onto it e.g. with git pull --rebase)
    # default = current # Only pull the current branch by default
# pull )))
# push (((
[push]
    autoSetupRemote = true
    default = simple   # (simple is the default since 2.0). The safest default for git-push: push only the current branch and only if it has the same name as upstream https://git-scm.com/docs/git-config#git-config-pushfollowTags
    followTags = true
# push )))
# rebase (((
[rebase]
    autoSquash = true # Automatically reposition !fixup/!squash commits in interactive rebase (useful with git commit --fixup/squash)
    autoStash = true
    updateRefs = true
# rebase )))
# rerere (((
[rerere]  # https://developer.mantidproject.org/GitConfig.html
    enabled = true # Reuse Recorded Resolutions - useful if you find yourself fixing the same conflicts over and over
    autoupdate = true # Auto-stage files resolved by rerere
# rerere )))
# status (((
[status]
    submodulesummary = 1
    # Sometimes a newly-added folder, since it's only one line in git status, can slip under the radar.
    # https://git-scm.com/docs/git-config#git-config-statusshowUntrackedFiles
    showUntrackedFiles = all
# status )))
