# alias (((
[alias]
    a = add
    ap = add --patch    # Get into the habit of using add --patch to create focused commits
    br = branch -vv     # A more verbose output from branch, showing the commit and upstream branch
    ca = commit --amend # Amend the latest commit
    cah = commit --amend --reuse-message=HEAD # Amend the latest commit reuse commit message from latest commit
    ci = commit
    co = checkout
    cp = cherry-pick
    df = diff
    dfs = diff --staged
    dlog = "!f() { GIT_EXTERNAL_DIFF=difft git log -p --ext-diff $@; }; f"
    g = grep
    l = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --branches # https://egghead.io/lessons/git-make-my-git-log-look-pretty-and-readable
    lfc = "!f() { git log --name-only --format= main.. | sort | uniq;  }; f" Show all of the files changed on the current branch i.e. since main
    lg = log --pretty=concise # Pretty oneline log with a bit more info than git log --oneline
    lgg = log --pretty=concise --graph # Pretty log showing as a graph
    lgm = log --pretty=concise main.. # Pretty log showing only the commits on the current branch i.e. since main
    lol = log --oneline --graph --all --decorate
    pl = pull
    ps = push
    pushfl = push --force-with-lease # Force push with lease (safer than push --force, but still be careful when changing history)
    pushu = push --set-upstream # When pushing a new branch upstream, set the local branch to track it
    r = rebase
    ri = rebase --interactive
    sb = show-branch
    sh = show --stat --pretty=detail # Show commit details with file names only
    shd = show --pretty=detail # Show commit details including diffs (same as git-show but slightly prettier)
    st = status #--short --branch
    sts = status --short # --branch  # A more concise output from status
    stsb = status --short --branch   # A more concise output from status, also showing which branch you're on

    # l = log --pretty=oneline -n 20 --all --graph --decorate

    # Aliases for code review (((
    # Borrowed from https://blog.jez.io/cli-code-review/
    files = !git diff --name-only $(git merge-base HEAD \"$REVIEW_BASE\")
    stat = !git diff --stat $(git merge-base HEAD \"$REVIEW_BASE\")
    review = !vim -p $(git files) -c \"tabdo Gdiff $REVIEW_BASE\" -c \"let g:gitgutter_diff_base = '$REVIEW_BASE'\"
    reviewone = !vim -p -c \"tabdo Gdiff $REVIEW_BASE\" -c \"let g:gitgutter_diff_base = '$REVIEW_BASE'\"

    # Check out a pull request for testing. (((
    # The first argument is the name of the remote and the second is the the pull request number,
    # e.g. git test-pr origin 12345
    test-pr = "!f() { git fetch $1 pull/$2/merge:pr/$2-merged && git checkout pr/$2-merged; }; f"

    # Remove all branches starting pr/
    test-pr-remove-all = "!f() { git branch | grep pr/ | xargs git branch -D; }; f"
    # )))

    # )))

