# custom aliases and functions using bat (((
test -x "$(command -v bat)" && BAT_PRESENT=1
if [ "$BAT_PRESENT" != "" ]; then
  # alias bathelp='bat --plain --language=help'
  helper() {
    "$@" --help 2>&1 | bat --plain --language=help
  }
  alias cat='bat'
  alias path='echo -e ${PATH//:/\\n} | bat' # Print each PATH entry on a separate line
  # alias dmesg='dmesg -HL --color=always | bat'

  # man() function using `batman` (((
  if [ -x "$(command -v batman)" ]; then
    man() {
      BAT_THEME="Monokai Extended" batman "$@"
      return $?
    }
  fi
  # )))
else
  alias path='echo -e ${PATH//:/\\n} | less' # Print each PATH entry on a separate line
  # alias dmesg='dmesg -HL --color=always | less'
fi
# )))

