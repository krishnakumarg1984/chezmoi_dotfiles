# aliases for compression tools (((

# Cross-platform compression file-formats (((
# Updated on 10 Feb 2024
# 7z: default lzma2. (7z decompression is single threaded). It does multithread compression (by default even). The 7z format does not store filesystem permissions (such as UNIX owner/group permissions or NTFS ACLs), and hence can be inappropriate for backup/archival purposes
# dar: disk archive (also the name of the tool is dar). Is GPL
# packARC: Good for media files. https://github.com/packjpg/packARC
# zip: introduced: 1989. latest update: 2016
# zpaq: introduced: 2009. latest update: 2016
# )))

# Notes on multi-core compresson tools (((

# lbzip2: *nix only. Parallel bzip2 compression utility, suited for serial and parallel processing
# lrzip: Compression utility that excels at compressing large files
# pbzip2: Parallel implementation of the bzip2 block-sorting file compressor
# pigz: Parallel implementation of gzip. It's a fully functional replacement for gzip
# pixz: Parallel indexing XZ compression, fully compatible with XZ. LZMA and LZMA2
# plzip: Has windows port. Massively parallel (multi-threaded) lossless data compressor based on lzlib
# PXZ: Runs LZMA compression on multiple cores and processors

# migz (lz format) tarlz (lz format), pixz (xz format), pzstd (zstd format) and lbzip2 (bz2 format) are the best since they support parallel decompression

# smallest filesize: pxz and pixz are faster; plzip and lrzip are slower
# largest filesize: pigz

# for algorithms, zpaq produces the smallest archives, but is the slowest
# )))

# aliases for bzip2 format (((
if [ -x "$(command -v lbzip2)" ]; then # supports parallel decompression
  alias bzip2='lbzip2'
  alias bunzip2='lbzip2 -d'
  if [ -x "$(command -v pv)" ]; then
    alias tarcbz2='tar --use-compress-program="lbzip2 | pv" -cf'
  else
    alias tarcbz2='tar --use-compress-program="lbzip2" -cf'
  fi
elif [ -x "$(command -v pbzip2)" ]; then
  alias bzip2='pbzip2'
  alias bunzip2='pbzip2 -d'
  if [ -x "$(command -v pv)" ]; then
    alias tarcbz2='tar --use-compress-program="pbzip2 | pv" -cf'
  else
    alias tarcbz2='tar --use-compress-program="pbzip2" -cf'
  fi
fi
# )))

# aliases for .gz format (((
# Can use 'pigz' to compress in 'zip' format by using the -K (upper case) flag e.g.: pigz -k -K archlinux.iso
if [ -x "$(command -v pigz)" ]; then
  alias gzip='pigz'
  alias gunzip='pigz -d'
  if [ -x "$(command -v pv)" ]; then
    alias tarcgz='tar --use-compress-program="pigz --best --recursive | pv" -cf'
  else
    alias tarcgz='tar --use-compress-program="pigz --best --recursive" -cf'
  fi
  # export TAR_OPTIONS="--use-compress-program=pbzip2" # https://askubuntu.com/questions/62607/whats-the-best-way-to-use-parallel-bzip2-and-gzip-by-default
  alias untar='tar --use-compress-program=pigz -xf'
fi
# )))

