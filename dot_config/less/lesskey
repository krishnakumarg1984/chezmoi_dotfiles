# LESSOPEN="|$(brew --prefix)/bin/lesspipe.sh %s" LESS_ADVANCED_PREPROCESSOR=1


# Turn off command and search history.
LESSHISTFILE="$HOME/.config/less/lesshistory.txt"

# LESS_TERMCAP_mb, etc. don't seem to work here :/
# http://unix.stackexchange.com/questions/87261/getting-unexpected-colorized-output-on-several-commands

# https://github.com/tpope/tpope/blob/master/.lesskey
#line-edit
\eb word-left
\ed word-delete
\ef word-right
^A home
^B left
^E end
^F right
^N down
^P up
^U kill-line
# \eD word-delete
# ^W word-backspace
# https://github.com/dLuna/config/blob/master/.lesskey

#command
/ forw-search ^W
? back-search ^W
# https://unix.stackexchange.com/questions/255862/search-in-less-with-wrap-around-at-eof
\eB back-search
\eF forw-search
/ noaction gg\eF
? noaction G\eB
