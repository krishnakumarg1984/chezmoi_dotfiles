# First, include any system-wide settings which are ignored
# by default if one has their own .inputrc
$include /etc/skel/.inputrc
$include /etc/inputrc

# do not bell on tab-completion
#set bell-style none

"\C-l":clear-screen

# Allow Meta (Alt) key bindings.
# set convert-meta on # Turns on 8th bit stripping
set convert-meta off # https://www.baeldung.com/linux/inputrc-file https://github.com/nficano/dotfiles/blob/master/home/inputrc

# The forward equivalent to this mode is called forward-search-history and is bound to Ctrl+s by default. Beware that most terminals override Ctrl+s to suspend execution until Ctrl+q is entered. (This is called XON/XOFF flow control). For activating forward-search-history, either disable flow control by issuing: $ `stty -ixon` or use a different key in inputrc. For example, to use Alt+s which is not bound by default:
"\es": forward-search-history


# Some defaults / modifications for the Emacs mode.
$if mode=emacs

# <C-up/down> for searching matching commands from the history.
"\e[1;5A": history-search-backward
"\e[1;5B": history-search-forward

# <C-left/right> to move by whole words.
"\e[1;5C": forward-word
"\e[1;5D": backward-word

Meta-p: history-search-backward
Meta-n: history-search-forward

$endif

# Show completion options on first tab; begin cycling on second tab. # Color the common prefix in menu-complete
set menu-complete-display-prefix on
# Show all available completion options on second tab.
set show-all-if-unmodified on
# a single tab will perform two steps: a) partially complete the word and b) show all possible completions if it is still ambiguous:
set show-all-if-ambiguous on
# Color files by types
set colored-stats on
# Also highlight the search prefix. Color the common prefix
set colored-completion-prefix on
# Append char to indicate type # Show symbols to denote file type of each completion option.

# Display "..." for already completed match in completions
# This line sets 3 to be the maximum number of characters to be the common prefix to display for completions.
# If the common prefix has more than 3 characters, they are replaced by ellipsis.
# set completion-prefix-display-length 3
set completion-prefix-display-length 10

# show extra file information when completing, like `ls -F` does
set visible-stats on

# completion is case-insensitive
set completion-ignore-case on
# Treat underscores and hyphens the same way for completion purposes
# set completion-map-case on
# Avoid duplicating text when completing an option mid-word.
# Be more intelligent when autocompleting by also looking at the text after the cursor.
# For example, when the current line is "cd ~/src/mozil", and the cursor is on the "z", pressing Tab will not autocomplete it to "cd ~/src/mozillail", but to "cd ~/src/mozilla".
# (This is supported by the Readline used by Bash 4.)
set skip-completed-text on  # correct completion from the middle of a word # https://github.com/3ximus/dotfiles/blob/master/.inputrc
# Append directories with a slash.
# set mark-directories on
# Do the same for symlinked directories (mark them) Append symlinks with an at.
set mark-symlinked-directories on
# If there are more than 200 possible completions for a word, ask to show them all
# # Show me up to 5,000 completion items, don't be shy
set completion-query-items 200
# Expand tilde to full path on completion
set expand-tilde on
# Preserve caret position while browsing through history lines
set history-preserve-point on
# Don't paginate possible completions # turns off the use of internal pager when returning long completion lists
set page-completions off

# Do not autocomplete hidden files unless the pattern explicitly begins with a dot
set match-hidden-files off

# Hard-code some UTF-8 conversion defaults.
set meta-flag on
set input-meta on
set output-meta on  # Keep the 8th bit for display

# Use Alt/Meta + Delete to delete the preceding word
"\e[3;3~": kill-word # https://github.com/nficano/dotfiles/blob/master/home/inputrc
## enable Alt-arrows
"\e[1;5D": backward-word ### Alt left
"\e[1;5C": forward-word ### Alt right

# for Xterm
"\eOH": beginning-of-line
"\eOF": end-of-line

# for linux console
"\e[1~": beginning-of-line
"\e[4~": end-of-line


# https://github.com/nficano/dotfiles/blob/master/home/inputrc
set print-completions-horizontally off

# Make sure we don't output everything on the 1 line https://github.com/ehusby/shell-utils/blob/main/linux_bash/config/.inputrc
set horizontal-scroll-mode Off

# https://github.com/astier/dotfiles/blob/master/inputrc, # don't echo character (eg. ^C) corresponding to the signal (eg. Ctrl-C)
# set echo-control-characters off  # https://github.com/jindraj/dotfiles/blob/master/.inputrc
# set enable-bracketed-paste off

# https://github.com/mhf-air/mhf-linux-config/blob/master/dotfiles/.inputrc

$if mode=vi
    set keyseq-timeout 80
    set show-mode-in-prompt on
    set vi-ins-mode-string \1\e[3 q\2
    set vi-cmd-mode-string \1\e[1 q\2

    # normal mode
    set keymap vi-command

    # insert mode
    set keymap vi-insert
    "hl": vi-movement-mode
    "\C-l": clear-screen
    "\C-p": previous-history
    # "\C-p": history-search-backward
    "\C-n": next-history
    # "\C-n": history-search-forward
    # RETURN: "\e\n"

    # Ctrl+left/right for word movement
    "\e\e[C": forward-word
    "\e\e[D": backward-word
    "\e[1;5C": forward-word
    "\e[1;5D": backward-word

$endif


# https://github.com/crramirez/dotfiles/blob/master/.inputrc
$if Bash
    # 'Magic Space'
    # Insert a space character then performs
    # a history expansion in the line
    Space: magic-space
$endif

# https://github.com/acherunilam/dot-files/blob/master/.inputrc
# undo changes to history lines when newline is received
set revert-all-at-newline on


# https://github.com/rafi/etc-skel/blob/master/.config/bash/inputrc
# Preserve caret position while browsing through history lines
set history-preserve-point on


# https://github.com/jindraj/dotfiles/blob/master/.inputrc
set blink-matching-paren on

