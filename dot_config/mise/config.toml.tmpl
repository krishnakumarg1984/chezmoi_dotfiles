[env]
MISE_ENV_FILE = ".env"

[tools]
node = "latest"                                     # Node.js JavaScript runtime
rust = { version = "latest", profile = "minimal" }  # Rust language. https://mise.en.dev/lang/rust.html

bat = "latest"                  # A cat(1) clone with wings. https://github.com/sharkdp/bat
bat-extras = "latest"           # Bash scripts that integrate bat with various command line tools. https://github.com/eth-p/bat-extras
bottom = "latest"               # Yet another cross-platform graphical process/system monitor. https://github.com/ClementTsang/bottom
bun = "latest"                  # Bun is a fast JavaScript all-in-one toolkit. https://mise.en.dev/lang/bun.html
cargo-binstall = "latest"       # Yet another cross-platform graphical process/system monitor. https://github.com/ClementTsang/bottom
difftastic = "latest"           # A structural diff that understands syntax. https://github.com/Wilfred/difftastic
dua = "latest"                  # View disk space usage and delete unwanted data, fast. https://github.com/Byron/dua-cli
duf = "latest"                  # Disk Usage/Free Utility - a better 'df' alternative. https://github.com/muesli/duf
dust = "latest"                 # A more intuitive version of du in rust. https://github.com/bootandy/dust
dyff = "latest"                 # A diff tool for YAML files, and sometimes JSON. https://github.com/homeport/dyff
eza = "latest"                  # A modern, maintained replacement for ls. https://github.com/eza-community/eza
fastfetch = "latest"            # An actively maintained, feature-rich and performance oriented, neofetch like system information tool. https://github.com/fastfetch-cli/fastfetch
fd = "latest"                   # A simple, fast and user-friendly alternative to 'find'. https://github.com/sharkdp/fd
fzf = "latest"                  # A command-line fuzzy finder. https://github.com/junegunn/fzf
gdu = "latest"                  # Fast disk usage analyzer with console interface written in Go. https://github.com/dundee/gdu
gh = "latest"                   # GitHub’s official command line tool. https://github.com/cli/cli
glow = "latest"                 # Render markdown on the CLI, with pizzazz. https://github.com/charmbracelet/glow
go = "latest"                   # go lang (Builtin plugin). https://mise.en.dev/lang/go.html
jless = "latest"                # jless is a command-line JSON viewer designed for reading, exploring, and searching through JSON data. https://github.com/PaulJuliusMartinez/jless
lua-language-server = "latest"  # A language server that offers Lua language support - programmed in Lua. https://github.com/LuaLS/lua-language-server
micromamba = "latest"           # Lightweight conda-compatible package manager. https://github.com/mamba-org/micromamba-releases
neovim = "latest"               # Vim-fork focused on extensibility and usability. https://github.com/mise-plugins/vfox-neovim
pandoc = "latest"               # Universal markup converter. https://github.com/jgm/pandoc
ripgrep = "latest"              # ripgrep recursively searches directories for a regex pattern while respecting your gitignore. https://github.com/BurntSushi/ripgrep
ripgrep-all = "latest"          # rga: ripgrep, but also search in PDFs, E-Books, Office documents, zip, tar.gz, etc. https://github.com/phiresky/ripgrep-all
ruby = "latest"                 # Ruby language. https://mise.en.dev/lang/ruby.html
ruff = "latest"                 # An extremely fast Python linter and code formatter, written in Rust. https://github.com/astral-sh/ruff
rush = "latest"                 # A cross-platform command-line tool for executing jobs in parallel. https://github.com/shenwei356/rush
shellcheck = "latest"           # ShellCheck, a static analysis tool for shell scripts. https://github.com/koalaman/shellcheck
shfmt = "latest"                # A shell parser, formatter, and interpreter with bash support; includes shfmt. https://github.com/mvdan/sh
starship = "latest"             # The minimal, blazing-fast, and infinitely customizable prompt for any shell. https://github.com/starship/starship
stylua = "latest"               # A Lua code formatter. https://github.com/JohnnyMorganz/StyLua
taplo = "latest"                # A TOML toolkit written in Rust. https://github.com/tamasfe/taplo
tinytex = "latest"              # A lightweight, cross-platform, portable, and easy-to-maintain LaTeX distribution based on TeX Live. https://github.com/mise-plugins/mise-tinytex
tlrc = "latest"                 # A tldr client written in Rust. https://github.com/tldr-pages/tlrc
topgrade = "latest"             # Upgrade all the things. https://github.com/topgrade-rs/topgrade
tree-sitter = "latest"          # An incremental parsing system for programming tools. https://github.com/tree-sitter/tree-sitter
usage = "latest"                # A specification for CLIs. https://github.com/jdx/usage
uv = "latest"                   # An extremely fast Python package installer and resolver, written in Rust. https://github.com/astral-sh/uv
viddy = "latest"                # A modern watch command. Time machine and pager etc. https://github.com/sachaos/viddy
zellij = "latest"               # A terminal workspace with batteries included. https://github.com/zellij-org/zellij

"cargo:bookokrat" = "latest"                                # A terminal-based EPUB/PDF Books reader. https://github.com/bugzmanov/bookokrat
"cargo:brush" = { version = "latest", locked = true }       # Rust-implemented shell focused on POSIX and bash compatibility. https://github.com/reubeno/brush
"cargo:cargo-cache" = "latest"                              # Manage cargo cache ($CARGO_HOME or ~/.cargo/), show sizes and remove directories selectively. https://github.com/matthiaskrgr/cargo-cache
"cargo:cargo-update" = "latest"                             # A cargo subcommand for checking and applying updates to installed executables. https://github.com/nabijaczleweli/cargo-update
"cargo:diskus" = "latest"                                   # A minimal, fast alternative to 'du -sh'. https://github.com/sharkdp/diskus
"cargo:erdtree" = "latest"                                  # A cross-platform, multi-threaded, and general purpose filesystem and disk usage utility that is aware of .gitignore and hidden file rules. https://github.com/solidiquis/erdtree
"cargo:mcat" = "latest"                                     # Terminal image, video, and Markdown viewer. https://github.com/Skardyy/mcat
"cargo:procs" = "latest"                                    # A modern replacement for ps. https://github.com/dalance/procs

"github:ayoisaiah/f2" = "latest"  # F2 is a cross-platform command-line tool for batch renaming files and directories quickly and safely. Written in Go! https://github.com/ayoisaiah/f2
 

