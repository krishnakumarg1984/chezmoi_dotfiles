# SSH Agent Setup -------------------(((
# Check if the `ssh-agent` command is available (whether the agent is installed)
if command -v "ssh-agent" > /dev/null 2>&1; then

  # Define a space-separated list of SSH keys you want to add to the agent.
  # You can specify the full path to each SSH private key.
  _ssh_keys_to_add="$HOME/.ssh/id_ed25519_nov13_2025 $HOME/.ssh/id_ed25519"
  case "$_ssh_keys_to_add" in *" "*)
  : ;;  # documented: SSH key paths must not contain spaces
  esac

  # Initialize an empty string to hold valid SSH keys that actually exist
  _valid_ssh_keys_for_keychain=""

  # Loop through the list of SSH keys to check if both the private key and its corresponding public key exist
  for _key in $_ssh_keys_to_add; do
    # Check if the private key file and the corresponding public key file exist
    if [ -f "$_key" ] && [ -f "$_key.pub" ]; then
      # If both exist, add the key to the valid keys list
      _valid_ssh_keys_for_keychain="$_valid_ssh_keys_for_keychain $_key"
    fi
  done

  # Update the list of SSH keys to add, now containing only valid keys
  _ssh_keys_to_add="$_valid_ssh_keys_for_keychain"

  # Check if the operating system is macOS (Darwin)
  if [ "$(uname)" = "Darwin" ]; then
    # On macOS, we can use the system's built-in SSH agent, which is automatically integrated with macOS's keychain.

    # Check if the SSH agent is already running by checking the SSH_AUTH_SOCK environment variable
    if [ -z "$SSH_AUTH_SOCK" ]; then
      # If the agent is not running, start it
      eval "$(ssh-agent -s 2>/dev/null)" >/dev/null
    fi

    # Add each valid SSH key to the SSH agent using ssh-add
    # if command -v "ssh-add" > /dev/null 2>&1; then
      set -- $_ssh_keys_to_add  # Set positional parameters to the valid keys
      # Loop through each key and add it to the agent
      while [ $# -gt 0 ]; do
        _current_ssh_key="$1"  # Get the current SSH key
        [ -f "$_current_ssh_key" ] && ssh-add "$_current_ssh_key" >/dev/null 2>&1  # Add the key if it exists
        shift  # Move to the next key in the list
      done
    # fi
  else
    # On Linux (or non-macOS systems), prefer using `keychain` if it's installed.
    # If keychain is installed, it will help manage the SSH agent and keys.

    if command -v "keychain" > /dev/null 2>&1; then
      _old_pos="$*"; set -- $_ssh_keys_to_add
      # Use `keychain` to manage the keys and the SSH agent
      eval "$(keychain --absolute --dir "${XDG_RUNTIME_DIR:-/tmp}/keychain" \
        --confallhosts --ignore-missing --nogui --ssh-allow-forwarded --quiet --systemd \
        "$@")"
      set -- $_old_pos; unset _old_pos
    else
      # If `keychain` isn't available, fall back to using the `ssh-agent` directly.

      # Start the SSH agent if it's not already running
      if [ -z "$SSH_AUTH_SOCK" ]; then
        eval "$(ssh-agent -s 2>/dev/null)" >/dev/null
      fi

      # Add each valid SSH key to the SSH agent using ssh-add
      # if command -v "ssh-add" > /dev/null 2>&1; then
        set -- $_ssh_keys_to_add  # Set positional parameters to the valid keys
        # Loop through each key and add it to the agent
        while [ $# -gt 0 ]; do
          _current_ssh_key="$1"  # Get the current SSH key
          [ -f "$_current_ssh_key" ] && ssh-add "$_current_ssh_key" >/dev/null 2>&1  # Add the key if it exists
          shift  # Move to the next key in the list
        done
      # fi
    fi
  fi
fi
