# Shell Command Type Detection (Optimized for speed and minimal dependencies) (((
#
# This function suite allows you to check if a command is:
# - A Builtin command
# - A Shell function
# - An External command (found in the PATH environment)
# - An Alias (for shells that support aliases)
#
# The implementation avoids using external tools, predefined environment variables,
# and is optimized for speed and portability across POSIX-compliant shells.
#
# Type codes returned by `command_type`:
#   0 = notfound      # Command does not exist.
#   1 = builtin       # Built-in shell command (e.g., `echo`, `cd`).
#   2 = function      # User-defined function.
#   3 = keyword       # Shell keyword (e.g., `if`, `then`, `else`).
#   4 = external      # External command found in `PATH`.
#   5 = alias         # Shell alias (for shells that support aliases).
#
# ------------------------------------------------------------------------------
# `command_type` - Check the type of a command
# ------------------------------------------------------------------------------
command_type() {
    name=$1
    # Create a variable for caching the command type (using associative array for efficiency)
    declare -gA __ct_cache

    # Skip lookup if the type is already cached (i.e., it's already identified as a builtin, function, etc.)
    if [[ -n "${__ct_cache[$name]}" ]]; then
        printf '%s\n' "${__ct_cache[$name]}"  # Return cached type
        return
    fi

    # Cache builtins and keywords for fast lookups (only once)
    if [[ -z "${__ct_builtins_cached}" ]]; then
        # Common builtins for most POSIX shells
        for b in : . break cd continue eval exec exit export getopts hash pwd readonly return shift test times trap unset wait; do
            __ct_cache["$b"]=1  # Mark as built-in command
        done
        # Common keywords for most POSIX shells
        for k in if then else elif fi case esac for select while until do done function time in ! { } [[ ]]; do
            __ct_cache["$k"]=3  # Mark as keyword
        done
        __ct_builtins_cached=1  # Mark builtins as cached
    fi

    # Check if it's a function by testing its existence in the shell
    if [[ "$(type -t "$name")" == "function" ]]; then
        __ct_cache["$name"]=2  # Mark as function
        printf '2\n'
        return
    fi

    # Check if it's a builtin by using `type` and verifying if it's a builtin
    if [[ "$(type -t "$name")" == "builtin" ]]; then
        __ct_cache["$name"]=1  # Mark as built-in
        printf '1\n'
        return
    fi

    # Alias check (only for Bash/Zsh, since other shells don't support aliases)
    case "$(basename "$0")" in
        bash|zsh)
            # Check if it's an alias for Bash/Zsh
            alias "$name" >/dev/null 2>&1 && { __ct_cache["$name"]=5; printf '5\n'; return; }
            ;;
        *)
            # No alias check for other shells (e.g., ksh93, ash, dash)
            ;;
    esac

    # Check for external command in PATH (only if not found yet)
    if [[ -z "${__ct_path_cached}" ]]; then
        old_IFS=$IFS  # Save the original IFS
        IFS=":"  # Split PATH into directories
        for dir in $PATH; do
            [[ -d "$dir" ]] || continue  # Skip non-directory entries
            if [[ -x "$dir/$name" ]]; then  # Check if the command is executable
                __ct_cache["$name"]=4  # Mark as external command
                printf '4\n'
                return
            fi
        done
        IFS=$old_IFS  # Restore the original IFS
        __ct_path_cached=1  # Mark PATH as cached
    fi

    # If still not found, mark as not found
    __ct_cache["$name"]=0  # Mark as not found
    printf '0\n'
}

# ------------------------------------------------------------------------------
# `command_type_name` - Convert type code to human-readable command type name
# ------------------------------------------------------------------------------
command_type_name() {
    # Converts the numeric type code to a human-readable type name
    case $1 in
        0) printf 'notfound\n' ;;  # Not found
        1) printf 'builtin\n' ;;   # Built-in command
        2) printf 'function\n' ;;  # User-defined function
        3) printf 'keyword\n' ;;   # Shell keyword
        4) printf 'external\n' ;;  # External command
        5) printf 'alias\n' ;;     # Alias (Bash/Zsh)
        *) printf 'unknown\n' ;;   # Unknown type
    esac
}

# ------------------------------------------------------------------------------
# `command_type_refresh_path` - Refresh cached PATH entries
# ------------------------------------------------------------------------------
command_type_refresh_path() {
    unset __ct_path_cached  # Reset the cached PATH entries
}

# ------------------------------------------------------------------------------
# `command_type_exists` - Check if any valid command type exists
# ------------------------------------------------------------------------------
command_type_exists() {
    result=$(command_type "$1")  # Capture the output of command_type

    # If the result is 0 (not found), return false (1)
    if [[ "$result" -eq 0 ]]; then
        return 1  # False: command not found
    fi

    # Otherwise, return true (0) because the command is either a builtin, function, or external
    return 0  # True: command exists (found as builtin, function, or external)
}

