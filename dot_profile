# Modern POSIX Shell Environment Manager (((
# ------------------------------------------------------------
# Features:
# 1. Fully POSIX `command_type` detection with caching.
# 2. Pure POSIX `update_env_var` for manipulating environment variables.
# 3. Supports deduplication, prepend/append, movefirst/movelast, remove.
# 4. Handles multi-character delimiters.
# 5. Verbose/quiet modes.
# ============================================================

# ============================================================
# -------------------- COMMAND TYPE DETECTION -----------------
# ============================================================

# Convert any string into a valid shell variable name
_ct_cache_key() {
    key="$1"
    key=${key//[^a-zA-Z0-9_]/_}
    printf '%s' "$key"
}

# Cache set/get
_ct_cache_set() {
    key=$(_ct_cache_key "$1")
    eval "__ct_cache_$key=$2"
}

_ct_cache_get() {
    key=$(_ct_cache_key "$1")
    eval "printf '%s' \"\${__ct_cache_$key:-}\""
}

# Return command type code:
# 0=notfound, 1=builtin, 2=function, 3=keyword, 4=external, 5=alias
command_type() {
    name=$1

    # Check cache first
    cached=$(_ct_cache_get "$name")
    [ -n "$cached" ] && { printf '%s\n' "$cached"; return; }

    # Explicit path
    case $name in */*) [ -x "$name" ] && [ ! -d "$name" ] && _ct_cache_set "$name" 4 && printf '4\n' && return || _ct_cache_set "$name" 0 && printf '0\n' && return ;; esac

    # type builtin
    out=$(type "$name" 2>/dev/null) || out=
    case $out in
        *"is a function"*) _ct_cache_set "$name" 2; printf '2\n'; return ;;
        *"is a shell builtin"*) _ct_cache_set "$name" 1; printf '1\n'; return ;;
        *"is a reserved word"*) _ct_cache_set "$name" 3; printf '3\n'; return ;;
    esac

    # alias detection
    if alias "$name" >/dev/null 2>&1; then _ct_cache_set "$name" 5; printf '5\n'; return; fi

    # PATH scan
    oldIFS=$IFS
    IFS=:
    for dir in $PATH; do
        [ -d "$dir" ] || continue
        [ -x "$dir/$name" ] && IFS=$oldIFS && _ct_cache_set "$name" 4 && printf '4\n' && return
    done
    IFS=$oldIFS

    _ct_cache_set "$name" 0
    printf '0\n'
}

# Convert type code to name
command_type_name() {
    case $1 in
        0) printf 'notfound\n' ;;
        1) printf 'builtin\n' ;;
        2) printf 'function\n' ;;
        3) printf 'keyword\n' ;;
        4) printf 'external\n' ;;
        5) printf 'alias\n' ;;
        *) printf 'unknown\n' ;;
    esac
}

# Existence checks
command_type_exists() { [ "$(command_type "$1")" -ne 0 ]; }
command_type_does_not_exist() { [ "$(command_type "$1")" -eq 0 ]; }

# Return absolute path (or command name for builtin/alias)
command_type_path() {
    name=$1
    t=$(command_type "$name")
    case "$t" in
        0) printf '' ;;
        4)
            case $name in */*) printf '%s' "$name" ;;
            *) oldIFS=$IFS; IFS=:; for dir in $PATH; do [ -x "$dir/$name" ] && IFS=$oldIFS && printf '%s' "$dir/$name" && return; done; IFS=$oldIFS ;;
            esac ;;
        1|2|3|5) printf '%s' "$name" ;;
        *) printf '' ;;
    esac
}

# ============================================================
# -------------------- UPDATE_ENV_VAR ------------------------
# ============================================================

update_env_var() {
    var="$1"
    operation="deduplicate"
    delimiter=":"
    entry=""
    verbose="no"
    quiet="no"

    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --verbose|-v) verbose="yes" ;;
            --quiet|-q) quiet="yes" ;;
            prepend|append|movefirst|movelast|remove) operation="$1" ;;
            --delimiter|-d) delimiter="$2"; shift ;;
            *) entry="$1" ;;
        esac
        shift
    done

    eval "val=\$$var"
    [ -z "$val" ] && val=""

    # Split into pseudo-array
    result_list=""
    remainder="$val"
    while [ -n "$remainder" ]; do
        case "$remainder" in
            *"$delimiter"*) tmp=${remainder%%"$delimiter"*}; result_list="$result_list
$tmp"; remainder=${remainder#*"$delimiter"} ;;
            *) result_list="$result_list
$remainder"; remainder="" ;;
        esac
    done

    # Deduplicate
    dedup_list=""
    seen=""
    oldIFS=$IFS
    IFS='
'
    for e in $result_list; do
        [ -z "$e" ] && continue
        case "$seen" in
            *"$delimiter$e$delimiter"*) continue ;;
            *) dedup_list="$dedup_list
$e"; seen="$seen$delimiter$e$delimiter" ;;
        esac
    done
    IFS=$oldIFS

    # Remove
    if [ "$operation" = "remove" ]; then
        new_list=""
        found="no"
        IFS='
'
        for e in $dedup_list; do
            [ "$e" = "$entry" ] && found="yes" || new_list="$new_list$delimiter$e"
        done
        IFS=$oldIFS
        [ "$found" != "yes" ] && { echo "Error: Entry '$entry' not found in $var." >&2; return 1; }
        dedup_list="$new_list"
    fi

    # Prepend/Append/Move
    if [ -n "$entry" ] && [ "$operation" != "remove" ]; then
        new_list=""
        IFS='
'
        for e in $dedup_list; do
            [ "$e" != "$entry" ] && new_list="$new_list$delimiter$e"
        done
        IFS=$oldIFS
        case "$operation" in
            prepend|movefirst) dedup_list="$entry$new_list" ;;
            append|movelast) dedup_list="$new_list$delimiter$entry" ;;
        esac
    fi

    # Cleanup leading delimiter
    case "$dedup_list" in "$delimiter"*) dedup_list=${dedup_list#"$delimiter"} ;; esac

    # Export variable
    eval "$var=\"\$dedup_list\""

    # Verbose
    [ "$quiet" != "yes" ] && [ "$verbose" = "yes" ] && printf '%s\n' "$dedup_list"
}

