path_prepend() {
  case ":${PATH-}:" in
    *:"$1":*) ;;
    *) PATH=$1${PATH:+":$PATH"} ;;
  esac
}

path_append() {
  case ":${PATH-}:" in
    *:"$1":*) ;;
    *) PATH=${PATH:+$PATH:}$1 ;;
  esac
}
