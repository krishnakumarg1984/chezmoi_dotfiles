# Remove '.' from PATH if present (PATH injection hardening) (((
case ":$PATH:" in
  *":.:"*)
    _new_path=
    _old_ifs=${IFS-}; IFS=:
    # Explicitly drop "." entries for PATH injection hardening
    for _p in $PATH; do
      [ "$_p" = "." ] || _new_path=${_new_path:+$_new_path:}$_p
    done
    IFS=$_old_ifs; unset _old_ifs _p
    PATH=$_new_path; unset _new_path
    ;;
esac
# )))

# SSH Agent Setup -------------------(((
# Check if interactive shell & if `ssh-agent` command is available (i.e the agent is installed)
if [ -n "$_INTERACTIVE_SHELL" ] && _has "ssh-agent"; then

  # A space-separated list of SSH private keys (with full path) to add to agent (((
  _ssh_keys_to_add="$HOME/.ssh/id_ed25519_nov13_2025 $HOME/.ssh/id_ed25519"
  case "$_ssh_keys_to_add" in *" "*)
    : ;;  # documented: SSH key paths must not contain spaces
  esac
  # )))

  # Obtain a sanitised/validated list of ssh keys to add to the agent (((

  # Initialize an empty string to hold valid SSH keys that actually exist
  _valid_ssh_keys_for_keychain=""

  # Loop through SSH key list to check if both the private key and its associated public key exist (((
  for _key in $_ssh_keys_to_add; do
    # Check if the private key file and the corresponding public key file exist
    if [ -r "$_key" ] && [ -r "$_key.pub" ]; then
      # If both exist, add the key to the valid keys list
      _valid_ssh_keys_for_keychain="$_valid_ssh_keys_for_keychain $_key"
    fi
  done
  # )))

  # Update the list of SSH keys to add, now containing only valid keys
  _ssh_keys_to_add="$_valid_ssh_keys_for_keychain"
  # ))) Obtained a validated/sanitised list of ssh keys to add

  # Actual addition of SSH keys tailored accordingly to the current OS (((
  # Obtain the operating system name
  _UNAME_S=$(uname -s 2>/dev/null || :)

  if [ "$_UNAME_S" = "Darwin" ]; then
    # On macOS, use the system's built-in SSH agent, which is integrated with macOS's keychain. (((

    # Check if the SSH agent is already running by checking the SSH_AUTH_SOCK environment variable (((
    if [ -z "$SSH_AUTH_SOCK" ]; then
      umask 077
      # If the agent is not running, start it
      _ssh_agent_out=$(ssh-agent -s 2>/dev/null) || :
      case $_ssh_agent_out in
        *SSH_AUTH_SOCK*) eval "$_ssh_agent_out" >/dev/null ;;
      esac
      unset _ssh_agent_out
    fi
    # )))

    # Add each valid SSH key to the SSH agent using ssh-add (((
    # if command -v "ssh-add" > /dev/null 2>&1; then
    set -- $_ssh_keys_to_add  # Set positional parameters to the valid keys
    while [ $# -gt 0 ]; do
      _current_ssh_key="$1"  # Get the current SSH key
      if [ -r "$_current_ssh_key" ]; then
        case $(ssh-add -l 2>/dev/null || :) in
          *"$_current_ssh_key"*) ;;
          *) ssh-add "$_current_ssh_key" >/dev/null 2>&1 ;;
        esac
      fi
      shift  # Move to the next key in the list
    done
    # fi
    # )))
    # )))
  else
 # On Linux or other non-macOS systems, prefer using `keychain` if it is installed (((
    # If keychain is installed, it will help manage the SSH agent and keys. (((
    if _has "keychain"; then
      # Use `keychain` to manage the keys and the SSH agent
      _keychain_out=$(keychain --absolute --dir "${XDG_RUNTIME_DIR:-/tmp}/keychain" \
        --confallhosts --ignore-missing --nogui --ssh-allow-forwarded --quiet --systemd \
        $_ssh_keys_to_add 2>/dev/null) || :
      case $_keychain_out in
        *SSH_AUTH_SOCK*) eval "$_keychain_out" >/dev/null ;;
      esac
      unset _keychain_out
      # )))
    else # where `keychain` isn't available, fall back to using the `ssh-agent` directly. (((
      # Start the SSH agent if it's not already running (((
      if [ -z "$SSH_AUTH_SOCK" ]; then
        umask 077
        _ssh_agent_out=$(ssh-agent -s 2>/dev/null) || :
        case $_ssh_agent_out in
          *SSH_AUTH_SOCK*) eval "$_ssh_agent_out" >/dev/null ;;
        esac
        unset _ssh_agent_out
      fi
      # )))

      # Add each valid SSH key to the SSH agent using ssh-add (((
      # if command -v "ssh-add" > /dev/null 2>&1; then
      set -- $_ssh_keys_to_add  # Set positional parameters to the valid keys
      while [ $# -gt 0 ]; do
        _current_ssh_key="$1"  # Get the current SSH key
        if [ -r "$_current_ssh_key" ]; then
          case $(ssh-add -l 2>/dev/null || :) in
            *"$_current_ssh_key"*) ;;
            *) ssh-add "$_current_ssh_key" >/dev/null 2>&1 ;;
          esac
        fi
        shift  # Move to the next key in the list
      done
      # fi
      # )))
    fi
    # )))
  # )))
  fi
  # )))

fi  # End of check for interactive shell and ssh-agent installed or not
