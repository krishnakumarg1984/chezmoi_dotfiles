  # prefer keychain if available, else fall back to (ssh-agent + ssh-add) (((
  if { [ -n "$SH_FUNCTIONS_SOURCED" ] && command_exists "keychain"; } || { type "keychain" > /dev/null 2>&1; }; then
    eval "$(keychain --absolute --dir "$XDG_RUNTIME_DIR"/keychain --confallhosts --ignore-missing --nogui --ssh-allow-forwarded --quiet --systemd $_ssh_keys_to_add)"

  else  # only basic ssh-agent is available (no keychain) (((
    [ -z "$SSH_AUTH_SOCK" ] && eval "$(ssh-agent -s)" >/dev/null  # Start the ssh-agent

    if { [ -n "$SH_FUNCTIONS_SOURCED" ] && command_exists "ssh-add"; } || { type "ssh-add" > /dev/null 2>&1; }; then
      set -- "$_ssh_keys_to_add"  # Set positional parameters based on the space-separated string

      # Add each ssh key one by one (((
      while [ $# -gt 0 ]; do
        _current_ssh_key="$1"
        [ -f "$_current_ssh_key" ] && ssh-add "$_current_ssh_key" >/dev/null 2>&1
        shift # Look at the next parameter
      done
    fi  # end of ssh-add step )))
