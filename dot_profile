# Set Locale with fallback to en_US.UTF-8 (((
# Check if the 'locale' command is available
if ! command -v locale >/dev/null 2>&1; then
  # Print message and fall back to en_US.UTF-8 if locale isn't available
  echo "Warning: 'locale' command not found. Falling back to en_US.UTF-8"
  LANG="en_US.UTF-8"
else
  # Check for 'en_GB' or 'en_US' locales using case statement
  case "$(locale -a 2>/dev/null || printf '')" in
    *"en_GB.UTF-8"*) LANG="en_GB.UTF-8" ;;  # Set to en_GB.UTF-8 if available
    *"en_US.UTF-8"*) LANG="en_US.UTF-8" ;;  # Set to en_US.UTF-8 if available
    *) LANG="en_US.UTF-8" ;;  # Default to en_US.UTF-8 if neither found
  esac
fi

# Set specific LC_* variables (some set to en_GB.UTF-8, others to C)
LC_COLLATE="C"             # Use C locale for sorting (e.g., for programming or POSIX tools)
LC_CTYPE="${LANG:-en_US.UTF-8}"  # Character classification and conversion (UTF-8 for character types)
LC_MESSAGES="$LANG"        # Messages and user interface text
LC_MONETARY="C"            # Monetary settings (POSIX standard)
LC_NAME="C"                # Name-related settings (POSIX standard)
LC_NUMERIC="C"             # Numeric settings (POSIX standard)
LC_PAPER="$LANG"           # Paper size (en_GB.UTF-8 or en_US.UTF-8)
LC_TIME="C"                # Time-related behavior (POSIX standard)

LC_ALL=""                   # Reset LC_ALL to allow specific LC_* variables to take effect

export LANG LC_COLLATE LC_CTYPE LC_MESSAGES LC_MONETARY LC_NAME LC_NUMERIC LC_PAPER LC_TIME LC_ALL
