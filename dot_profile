# -------------------- COMMAND TYPE DETECTION SUITE (((
# Fully POSIX-compliant, zero external dependencies
# Works on: ash, dash, busybox sh, bash, sh, ksh, ksh93, mksh, zsh
# Detectable types:
#   0 = notfound
#   1 = builtin
#   2 = function
#   3 = keyword (reserved word)
#   4 = external command in PATH or explicit/relative path
#   5 = alias (only supported in shells: bash, zsh, mksh, ksh)
# Features:
#   • Safe caching
#   • Handles absolute and relative paths
#   • Alias detection where available
#   • Returns absolute path if requested
# -----------------------------------------------------------------------

# -------------------- INTERNAL SAFE CACHE -----------------------------

# Convert any string into a valid shell variable name (POSIX-only, no sed)
_ct_cache_key() {
    key="$1"
    key=${key//[^a-zA-Z0-9_]/_}  # replace non-alnum/_ with _
    printf '%s' "$key"
}

# Set a cache entry
_ct_cache_set() {
    key=$(_ct_cache_key "$1")
    eval "__ct_cache_$key=$2"
}

# Get a cache entry
_ct_cache_get() {
    key=$(_ct_cache_key "$1")
    eval "printf '%s' \"\${__ct_cache_$key:-}\""
}

# -------------------- COMMAND TYPE FUNCTION ---------------------------

# Usage: command_type <name>
# Returns type code:
# 0=notfound, 1=builtin, 2=function, 3=keyword, 4=external, 5=alias
command_type() {
    name=$1

    # 1. Check cached type
    cached=$(_ct_cache_get "$name")
    if [ -n "$cached" ]; then
        printf '%s\n' "$cached"
        return
    fi

    # 2. Explicit path detection
    case $name in
        */*)
            if [ -x "$name" ] && [ ! -d "$name" ]; then
                _ct_cache_set "$name" 4
                printf '4\n'
                return
            else
                _ct_cache_set "$name" 0
                printf '0\n'
                return
            fi
            ;;
    esac

    # 3. POSIX type detection via type builtin
    out=$(type "$name" 2>/dev/null) || out=
    case $out in
        *"is a function"*)
            _ct_cache_set "$name" 2
            printf '2\n'
            return
            ;;
        *"is a shell builtin"*)
            _ct_cache_set "$name" 1
            printf '1\n'
            return
            ;;
        *"is a reserved word"*)
            _ct_cache_set "$name" 3
            printf '3\n'
            return
            ;;
    esac

    # 4. Alias detection (bash/zsh/mksh/ksh)
    if alias "$name" >/dev/null 2>&1; then
        _ct_cache_set "$name" 5
        printf '5\n'
        return
    fi

    # 5. PATH scan for external commands
    oldIFS=$IFS
    IFS=:
    for dir in $PATH; do
        [ -d "$dir" ] || continue
        if [ -x "$dir/$name" ]; then
            IFS=$oldIFS
            _ct_cache_set "$name" 4
            printf '4\n'
            return
        fi
    done
    IFS=$oldIFS

    # 6. Not found
    _ct_cache_set "$name" 0
    printf '0\n'
}

# -------------------- CONVERT TYPE CODE TO NAME -----------------------

command_type_name() {
    case $1 in
        0) printf 'notfound\n' ;;
        1) printf 'builtin\n' ;;
        2) printf 'function\n' ;;
        3) printf 'keyword\n' ;;
        4) printf 'external\n' ;;
        5) printf 'alias\n' ;;
        *) printf 'unknown\n' ;;
    esac
}

# -------------------- EXISTENCE CHECK FUNCTIONS -----------------------

command_type_exists() {
    t=$(command_type "$1")
    [ "$t" -ne 0 ]
}

command_type_does_not_exist() {
    t=$(command_type "$1")
    [ "$t" -eq 0 ]
}

# -------------------- GET ABSOLUTE PATH OF COMMAND --------------------

# Returns absolute path for external commands, explicit paths,
# or command name for builtin/function/alias/keyword
command_type_path() {
    name=$1
    t=$(command_type "$name")

    case "$t" in
        0)  # not found
            printf ''
            ;;
        4)  # external
            case $name in
                */*)  # explicit path
                    printf '%s' "$name"
                    ;;
                *)    # search PATH
                    oldIFS=$IFS
                    IFS=:
                    for dir in $PATH; do
                        [ -d "$dir" ] || continue
                        if [ -x "$dir/$name" ]; then
                            IFS=$oldIFS
                            printf '%s' "$dir/$name"
                            return
                        fi
                    done
                    IFS=$oldIFS
                    ;;
            esac
            ;;
        1|2|3|5)  # builtin, function, keyword, alias
            printf '%s' "$name"
            ;;
        *) printf '' ;;
    esac
}

