# FUNCTION: update_env_var (((
# Purpose:
#   This function modifies a colon-separated environment variable (e.g., PATH)
#   by performing operations such as prepending, appending, removing, moving first,
#   or moving last entries. It also performs **deduplication** by default, ensuring
#   no duplicates are present in the variable.
#
# Arguments:
#   $1 - (Required) The environment variable to modify (e.g., PATH).
#   $2 - (Optional) The operation: prepend, append, movefirst, movelast, remove (default: deduplication).
#   $3 - (Required) The new entry to add, prepend, remove, or move.
#   $4 - (Optional) Delimiter to use for splitting the environment variable (default is colon ":").
#   $5 - (Optional) Flags: --verbose, -v, --quiet, -q (overrides default behavior).
#
# Returns:
#   - Updates the specified environment variable by modifying its value.
#
# Operations:
#   1. **prepend** - Adds the new entry at the beginning of the environment variable.
#   2. **append** - Adds the new entry at the end of the environment variable (default behavior).
#   3. **movefirst** - Moves the specified entry to the beginning of the environment variable.
#   4. **movelast** - Moves the specified entry to the end of the environment variable.
#   5. **remove** - Removes the specified entry from the environment variable. If the entry is not found, prints an error to stderr.
#   6. **deduplicate** - Ensures no duplicate entries are present in the environment variable (default if no operation is specified).
#
# Flags:
#   --verbose (-v)  : Prints the updated environment variable after modification.
#   --quiet (-q)    : Suppresses output (no print).
#   --delimiter (-d): Custom delimiter for separating entries (default is colon ":").
#
# ============================================================
update_env_var() {
    # Initialize default values
    var="$1"       # The environment variable name (e.g., PATH)
    operation="deduplicate"  # Default operation is deduplication
    verbose="no"
    quiet="no"
    delimiter=":"  # Default delimiter is colon
    entry=""

    # Check if the shell is interactive (based on the $- variable)
    is_interactive_shell="${-#*i}"  # Remove the "i" character if it's interactive; check if it’s empty
    if [ -n "$is_interactive_shell" ]; then
        verbose="yes"  # Default to verbose (echo updated value) in interactive shells
    fi

    # Parse the arguments, process flags and operation
    shift  # Shift off the first argument (var)

    # Loop through the remaining arguments to process flags and operation
    while [ $# -gt 0 ]; do
        case "$1" in
            --verbose|-v) verbose="yes" ;;  # Verbose flag
            --quiet|-q) quiet="yes" ;;     # Quiet flag
            prepend|append|movefirst|movelast|remove) operation="$1" ;;  # Operation flags
            --delimiter|-d) delimiter="$2"; shift ;;  # Delimiter flag, shift for delimiter value
            *) entry="$1" ;;  # The entry to modify the variable with
        esac
        shift  # Move to the next argument
    done

    # If no entry is provided, and the operation is "deduplicate", just perform deduplication
    if [ -z "$entry" ] && [ "$operation" != "remove" ]; then
        operation="deduplicate"
    fi

    # If no entry is provided for non-deduplication operations, show an error and exit
    if [ -z "$entry" ] && [ "$operation" != "deduplicate" ]; then
        echo "Error: No entry specified to modify the variable." >&2
        return 1
    fi

    # Retrieve the current value of the environment variable
    val="${!var}"  # Indirect expansion to get the value of the environment variable.

    # If the variable is empty, set it to an empty string
    if [ -z "$val" ]; then
        val=""
    fi

    # Split the current value into an array of entries
    IFS="$delimiter" read -r -a entries <<< "$val"

    # Perform deduplication using a list of seen entries (no associative arrays)
    seen=""
    result=()

    # Loop through entries and add unique ones to the result
    for e in "${entries[@]}"; do
        # Check if the entry has been seen before by searching the "seen" list
        if echo "$seen" | grep -q "$delimiter$e$delimiter\|^$e$delimiter\|$delimiter$e$"; then
            continue  # Skip the entry if it's already seen.
        fi

        # Add the entry to the result
        result+=("$e")
        seen="$seen$delimiter$e"  # Track the seen entry
    done

    # Handle the remove operation (explicitly remove the entry)
    if [ "$operation" = "remove" ]; then
        # Check if the entry exists in the array before removing
        found="no"
        result=()
        for e in "${entries[@]}"; do
            if [ "$e" != "$entry" ]; then
                result+=("$e")
            else
                found="yes"
            fi
        done

        # If the entry wasn't found, print an error to stderr
        if [ "$found" = "no" ]; then
            echo "Error: Entry '$entry' not found in $var." >&2
            return 1
        fi
    fi

    # Handle adding or moving the new entry
    if [ -n "$entry" ]; then
        # Check if the entry already exists in the result (for deduplication)
        if echo "$seen" | grep -q "$delimiter$entry$delimiter\|^$entry$delimiter\|$delimiter$entry$"; then
            # If entry already exists, perform movefirst or movelast operation
            if [ "$operation" = "movefirst" ]; then
                result=("$entry" "${result[@]/$entry}")  # Move to the first position
            elif [ "$operation" = "movelast" ]; then
                result=("${result[@]/$entry}" "$entry")  # Move to the last position
            fi
        else
            # Perform prepend, append, or move based on the operation
            if [ "$operation" = "prepend" ]; then
                result=("$entry" "${result[@]}")  # Prepend new entry.
            elif [ "$operation" = "append" ]; then
                result+=("$entry")  # Append new entry.
            fi
        fi
    fi

    # Reassemble the variable and update it
    new_value=$(IFS="$delimiter"; echo "${result[*]}")

    # Remove any leading/trailing delimiter (colon) in the final value
    new_value="${new_value##${delimiter}}"  # Remove leading colon
    new_value="${new_value%%${delimiter}}"  # Remove trailing colon

    export "$var=$new_value"

    # Suppress output if quiet flag is set
    if [ "$quiet" = "yes" ]; then
        return 0  # No output in quiet mode.
    fi

    # Handle verbose mode (only output the updated value after the operation)
    if [ "$verbose" = "yes" ]; then
        echo "$new_value"
    fi
}

