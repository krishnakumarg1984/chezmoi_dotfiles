# # ------------------- AddressSanitizer (ASAN) Options (((
# # https://stackoverflow.com/a/54373833
# # Configure ASAN for safer debugging and controlled crash behavior
# ASAN_OPTIONS="abort_on_error=1:detect_leaks=0:report_objects=1:sleep_before_dying=1"
# export ASAN_OPTIONS
# # abort_on_error=1
# # ASan calls abort() immediately on the first detected error.
# # Great for:
# # Getting a core dump
# # Ensuring crashes are loud and unignorable
# # You won’t get “best effort” continuation after errors.
# # detect_leaks=0
# # Disables LeakSanitizer.
# # Useful when:
# # You’re already using Valgrind / heaptrack
# # You want faster runs
# # Leak reports are noisy or irrelevant (e.g., short-lived tools)
# # Note: If your binary is built with -fsanitize=address,leak, this overrides the leak part at runtime.
# # report_objects=1
# # ASan reports the actual heap objects involved in errors.
# # Makes UAF / OOB bugs way easier to reason about.
# # Minor runtime cost, major debugging win.
# # sleep_before_dying=1
# # ASan sleeps for 1 second before aborting.
# # Super handy for:
# # * Attaching gdb or lldb
# # * Letting logs flush
# # If you ever want interactive debugging:
# # sleep_before_dying=10
# # “Fail fast, fail loudly, and give me enough context to fix it.”
# # It’s ideal for:
# # * Debug builds
# # * CI jobs where crashes should halt everything
# # * Reproducible bug hunting
# # )))

