# ------------------- POSIX FZF Terminal-Aware Setup ------------------(((
# --- Helper to check external tools --------------------------------------
_has() { command -v "$1" >/dev/null 2>&1; }

_HAS_KITTY=0
_HAS_WEZTERM=0
_HAS_ITERM=0
[ -n "$KITTY_WINDOW_ID" ] && _HAS_KITTY=1
[ -n "$WEZTERM_EXECUTABLE" ] && _HAS_WEZTERM=1
[ "$TERM_PROGRAM" = "iTerm.app" ] && _HAS_ITERM=1

# --- Terminal size helper -----------------------------------------------
_fzf_term_size() {
  C=${COLUMNS:-80}
  L=${LINES:-24}
  COLS=$C
  LINES_PREVIEW=$((L-2))
}

# --- File kind detection -----------------------------------------------
_fzf_kind() {
  file=$1
  case "$file" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp) printf image ;;
    *.mp4|*.mkv|*.mov|*.avi) printf video ;;
    *.mp3|*.flac|*.wav|*.ogg) printf audio ;;
    *.zip|*.tar|*.tgz|*.tar.gz|*.tar.xz|*.xz|*.7z) printf archive ;;
    *.pdf) printf pdf ;;
    *.patch) printf patch ;;
    *.md|*.txt|*.json|*.yaml|*.yml|*.toml|*.sh|*.zsh|*.fish|*.py|*.rs|*.go|*.c|*.h|*.cpp|*.js|*.ts|*.html|*.css)
      printf text ;;
    *)
      b=$(dd if="$file" bs=1 count=1 2>/dev/null)
      case "$b" in
        ''|[![:print:]]) printf binary ;;
        *) printf text ;;
      esac
      ;;
  esac
}

# --- Preview primitives -----------------------------------------------

_fzf_preview_text() {
  f=$1
  if _has bat; then
    bat --style=plain --color=always --pager=never "$f"
    return
  fi
  if _has less; then
    less -RFX "$f"
    return
  fi
  cat "$f"
}

_fzf_preview_pdf() {
  f=$1
  _fzf_term_size
  if _has pdftotext; then
    pdftotext -layout "$f" - | head -n "$LINES_PREVIEW"
  else
    printf 'PDF: %s\n' "$f"
  fi
}

_fzf_preview_image() {
  f=$1
  _fzf_term_size
  W=$COLS
  H=$LINES_PREVIEW

  if [ "$_HAS_KITTY" -eq 1 ] && _has kitty; then
    mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)
    cache_id=$(echo "$f-$mtime" | tr '/ ' '_')
    kitty +kitten icat --clear=no --place="${W}x${H}@0x0" --sync --stdin-name="$cache_id" "$f"
    return
  fi
  if [ "$_HAS_WEZTERM" -eq 1 ] && _has wezterm; then
    wezterm imgcat "$f"
    return
  fi
  if [ "$_HAS_ITERM" -eq 1 ] && _has imgcat; then
    imgcat "$f"
    return
  fi
  printf 'Image: %s\n' "$f"
}

_fzf_preview_video() {
  f=$1
  _fzf_term_size
  W=$COLS
  H=$LINES_PREVIEW

  if _has ffmpeg; then
    tmp_img="/tmp/fzf_vid_preview_$$.png"
    ffmpeg -v quiet -y -i "$f" -vframes 1 -vf "scale=${W}:-1" "$tmp_img" 2>/dev/null
    _fzf_preview_image "$tmp_img"
    rm -f "$tmp_img"
    return
  fi
  if _has ffprobe; then
    ffprobe "$f" 2>/dev/null
    return
  fi
  printf 'Video: %s\n' "$f"
}

_fzf_preview_audio() {
  f=$1
  if _has ffprobe; then
    ffprobe "$f" 2>/dev/null
  else
    printf 'Audio: %s\n' "$f"
  fi
}

_fzf_preview_patch() {
  f=$1
  if _has git && git rev-parse --show-toplevel >/dev/null 2>&1; then
    git show --color=always "$f" 2>/dev/null
  else
    printf 'Patch: %s\n' "$f"
  fi
}

_fzf_preview_binary() {
  f=$1
  printf 'Binary: %s\n' "$f"
}

_fzf_preview_symbols() {
  f=$1
  if _has ctags; then
    ctags -x --sort=no "$f" 2>/dev/null
  fi
}

_fzf_preview_dir() {
  d=$1
  if _has eza; then
    eza --icons --group-directories-first "$d"
    return
  fi
  ls "$d"
}

# --- Archive tree preview ----------------------------------------------
_fzf_preview_archive_tree() {
  f=$1
  _fzf_term_size
  L=$LINES_PREVIEW
  case "$f" in
    *.zip)
      if _has unzip; then
        unzip -l "$f" 2>/dev/null | awk '{print $4}' | sed 1,3d | head -n "$L"
      else
        printf 'zip: %s\n' "$f"
      fi
      ;;
    *.tar)
      tar -tf "$f" 2>/dev/null | head -n "$L" ;;
    *.tar.gz|*.tgz)
      tar -tzf "$f" 2>/dev/null | head -n "$L" ;;
    *.tar.xz)
      tar -tJf "$f" 2>/dev/null | head -n "$L" ;;
    *.7z)
      if _has 7z; then
        7z l "$f" 2>/dev/null | awk '/^----/{p=1;next} p {print $NF}' | head -n "$L"
      else
        printf '7z: %s\n' "$f"
      fi
      ;;
    *)
      printf 'Archive: %s\n' "$f" ;;
  esac
}

# --- Unified preview router ---------------------------------------------
_fzf_preview() {
  t=$1
  if [ -d "$t" ]; then
    _fzf_preview_dir "$t"
    return
  fi
  kind=$(_fzf_kind "$t")
  case "$kind" in
    text) _fzf_preview_text "$t"; _fzf_preview_symbols "$t" ;;
    pdf) _fzf_preview_pdf "$t" ;;
    image) _fzf_preview_image "$t" ;;
    video) _fzf_preview_video "$t" ;;
    audio) _fzf_preview_audio "$t" ;;
    archive) _fzf_preview_archive_tree "$t" ;;
    patch) _fzf_preview_patch "$t" ;;
    binary) _fzf_preview_binary "$t" ;;
    *) printf 'File: %s\n' "$t" ;;
  esac
}

# --- FZF default command -----------------------------------------------
if _has fd; then
  FZF_DEFAULT_COMMAND='fd --hidden --follow --exclude .git'
else
  FZF_DEFAULT_COMMAND='find . -type f 2>/dev/null'
fi
export FZF_DEFAULT_COMMAND

# --- FZF default options (POSIX-compliant) -----------------------------
export FZF_DEFAULT_OPTS="--layout=reverse \
--border=rounded \
--height=80% \
--prompt=> \
--info=inline \
--preview='_fzf_preview {}' \
--preview-window=right:60%:wrap \
--bind=ctrl-p:toggle-preview,ctrl-o:change-preview-window(right|down|hidden),ctrl-w:toggle-preview-wrap,?:toggle-help \
--header='Enter open | Ctrl-P preview | Ctrl-O layout | Ctrl-W wrap | ? help'"

# --- Ctrl-T / Alt-C integration --------------------------------------
export FZF_CTRL_T_OPTS="--preview='_fzf_preview {}'"
export FZF_ALT_C_OPTS="--preview='if _has eza; then eza --icons {} 2>/dev/null; else ls {}; fi'"

# --- Ctrl-R reverse history ------------------------------------------
export FZF_CTRL_R_OPTS="--height 50% --layout=reverse --prompt='History> ' --info=inline --preview='_fzf_preview \$(echo {} 2>/dev/null)'"

# --- Git commit browser (optional) -------------------------------------
fzf_git_commits() {
  if ! _has git || ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    return
  fi
  git log --graph --oneline --decorate --color=always | \
  fzf --ansi --preview='git show --color=always {}'
}

