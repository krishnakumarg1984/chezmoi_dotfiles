if command -v "python" > /dev/null 2>&1 || command -v "python3" > /dev/null 2>&1; then

  _pythonrc="$_xdg_config_home/python/pythonrc"
  if [ -f "$_pythonrc" ]; then
    PYTHONSTARTUP="$_pythonrc"
    export PYTHONSTARTUP
  fi
  unset _pythonrc

  _python_histdir="$_xdg_state_home/python"
  if ! [ -d "$_python_histdir" ]; then
    mkdir -p "$_python_histdir"
  fi
  PYTHON_HISTORY="$_python_histdir/python_history"
  unset _python_histdir

  PYTHON_EGG_CACHE="$_xdg_cache_home/python-eggs"
  PYTHONPYCACHEPREFIX="$_xdg_cache_home/python"
  PYTHONUSERBASE="$_xdg_data_home/python"
  export PYTHON_HISTORY PYTHON_EGG_CACHE PYTHONPYCACHEPREFIX PYTHONUSERBASE
fi
# )))

