# Set VISUAL, EDITOR and SUDO_EDITOR (((
# List of preferred editors in order of preference
_editor_priority_list="nvim vim vi emacs nano"

# Save the current IFS to restore later
_old_ifs="$IFS"

# Set IFS to space to split the list into individual words
IFS=" "

# Trim leading and trailing spaces from the list
if [ -n "$SH_FUNCTIONS_SOURCED" ] && command -v "trim_spaces" >/dev/null 2>&1; then
  _editor_priority_list=$(trim_spaces "$_editor_priority_list")
fi

# Try to find the first available editor in the list
for editor in $_editor_priority_list; do
  # Check if the editor exists and is executable
  if command -v "$editor" >/dev/null 2>&1; then
    VISUAL="$editor"  # Set VISUAL to the first available editor's name
    break
  fi
done

# Restore the original IFS
IFS="$_old_ifs"
unset _old_ifs

# Set both SUDO_EDITOR and EDITOR to the same editor
SUDO_EDITOR="$VISUAL"
EDITOR="$VISUAL"

# Export the variables to make them available in the environment
export VISUAL EDITOR SUDO_EDITOR

# Clean up the temporary variable to avoid polluting the environment
unset _editor_priority_list
