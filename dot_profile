# GCC_COLORS Setup (((
# This configuration leverages 24-bit RGB colors for modern terminals while
# falling back to classic 16-color ANSI codes for older terminals.
# It covers all GCC diagnostic elements: errors, warnings, notes, code ranges,
# file paths, diff highlights, and fixit hints.
# -----------------------------------------------------------------------------

# Detect if terminal supports truecolor
# Some terminals set COLORTERM to "truecolor" or "24bit"
if [ "${COLORTERM-}" = "truecolor" ] || [ "${COLORTERM-}" = "24bit" ]; then
    # ------------------- Truecolor 24-bit GCC_COLORS -------------------
    # Format: 38;2;<R>;<G>;<B> foreground, 48;2;<R>;<G>;<B> background
    GCC_COLORS="\
error=38;2;255;0;0:warning=38;2;255;165;0:note=38;2;0;255;255:\
range1=38;2;0;255;0:range2=38;2;0;0;255:locus=38;2;255;255;0:\
quote=38;2;255;0;255:path=38;2;0;255;255:fixit-insert=38;2;0;200;0:fixit-delete=38;2;200;0;0:\
diff-filename=38;2;255;255;255:diff-hunk=38;2;0;255;0:diff-delete=38;2;255;0;0:diff-insert=38;2;0;255;0:\
type-diff=38;2;0;255;255"
else
    # ------------------- Fallback to Classic 16-Color ANSI -------------------
    GCC_COLORS="\
error=01;31:warning=01;35:note=01;36:range1=32:range2=34:locus=01:\
quote=01:path=01;36:fixit-insert=32:fixit-delete=31:\
diff-filename=01:diff-hunk=32:diff-delete=31:diff-insert=32:\
type-diff=01;32"
fi

# Export GCC_COLORS for all GCC invocations
export GCC_COLORS

# -----------------------------------------------------------------------------
# Explanation of Key Fields:
# - error / warning / note: Highlight GCC diagnostics in red, orange, cyan
# - range1 / range2: Highlight ranges in green / blue for code selection
# - locus: Emphasize the locus (location) of diagnostic
# - quote: Quoted strings in diagnostics
# - path: File paths
# - fixit-insert / fixit-delete: Proposed code modifications
# - diff-filename / diff-hunk / diff-delete / diff-insert / type-diff: Highlight diffs in compiler output
# -----------------------------------------------------------------------------
# )))

# ------------------- Git Editor and Diff Setup ------------------- (((

# Use VISUAL as Git editor, optionally start in insert mode for vim/neovim (((
if [ -n "$VISUAL" ]; then
    GIT_EDITOR="$VISUAL -c 'startinsert'"
    export GIT_EDITOR
fi
# )))

# Use 'difft' as Git external diff tool if available (((
if command_type_exists difft; then
    GIT_EXTERNAL_DIFF=$(command_type_path difft)
    export GIT_EXTERNAL_DIFF
fi
# )))

# ------------------- Git Pager Setup -------------------(((
# Prefer 'bat' as Git pager if available, fallback to 'less'
if [ -n "$BAT_PRESENT" ]; then
    # Use bat for Git output with plain style and header
    GIT_PAGER="bat --style=plain,header"
else
    # Fallback to less
    GIT_PAGER="less"
fi
export GIT_PAGER
# )))

# )))

# ------------------- Go Environment ------------------ (((
# Set Go cache, module cache, and GOPATH to user-specific directories
GOCACHE="$HOME/.local/state/go/go-build" && export GOCACHE
GOMODCACHE="$HOME/.local/state/go/mod" && export GOMODCACHE
GOPATH="$HOME/.local/share/go" && export GOPATH
# )))

# ------------------- Homebrew Environment ------------------- (((
# Set HOMEBREW_PREFIX if brew is installed and custom location exists
if command_type_exists brew; then
    if [ -d "$HOME/.local/opt/brew" ]; then
        HOMEBREW_PREFIX="$HOME/.local/opt/brew"
        export HOMEBREW_PREFIX
    fi
fi
# )))

# ------------------- Jupyter Configuration ------------------- (((
# Set JUPYTER_CONFIG_DIR to a user-specific config directory
JUPYTER_CONFIG_DIR="$HOME/.config/jupyter"
export JUPYTER_CONFIG_DIR
# )))

# ------------------- Nodejs Configuration ------------------- (((
# ------------------- Node.js REPL History -------------------
# Set NODE_REPL_HISTORY to a custom location for persistent REPL history
NODE_REPL_HISTORY="$HOME/.local/state/node_repl_history"
export NODE_REPL_HISTORY

# ------------------- NPM User Configuration -------------------
# Set NPM_CONFIG_USERCONFIG if a custom npmrc exists
if [ -r "$HOME/.config/npm/npmrc" ]; then
    NPM_CONFIG_USERCONFIG="$HOME/.config/npm/npmrc"
    export NPM_CONFIG_USERCONFIG
fi
# )))

# ------------------- Readline Inputrc ------------------- (((
# Set INPUTRC if a custom readline configuration exists
if [ -r "$HOME/.config/readline/inputrc" ]; then
    INPUTRC="$HOME/.config/readline/inputrc"
    export INPUTRC
fi
# )))

# ------------------- Python Startup File ------------------- (((
# Set PYTHONSTARTUP if the user has a custom Python startup script
if [ -r "$HOME/.config/python/pythonrc" ]; then
    PYTHONSTARTUP="$HOME/.config/python/pythonrc"
    export PYTHONSTARTUP
fi
# )))

# ------------------- Qt6 Configuration Tool ------------------- (((
# Set Qt platform theme if qt6ct is available
if command_type_exists qt6ct; then
    QT_QPA_PLATFORMTHEME="qt6ct"
    export QT_QPA_PLATFORMTHEME
fi
# )))

# ------------------- Ruff Cache Directory ------------------- (((
# Set cache directory for the Ruff linter
RUFF_CACHE_DIR="$HOME/.local/state/ruff"
export RUFF_CACHE_DIR
# )))

# ------------------- Rustup Environment -------------------(((
# Set Rustup home directory
RUSTUP_HOME="$HOME/.local/share/rustup"
export RUSTUP_HOME
# )))

# ------------------- GNU Screen Configuration -------------------(((
# Set user-specific screen configuration and socket directory if screen exists
if command_type_exists screen && [ -r "$HOME/.config/screen/screenrc" ]; then
    SCREENRC="$HOME/.config/screen/screenrc"
    export SCREENRC

    SCREENDIR="${XDG_RUNTIME_DIR:-/tmp}/screen"
    export SCREENDIR
fi
# )))

# ------------------- w3m Configuration ------------------ (((
# Set user-specific w3m config directory if w3m exists
if command_type_exists w3m; then
    W3M_DIR="$HOME/.config/w3m"
    export W3M_DIR
fi
# )))

# ------------------- Wget Configuration ------------------- (((
# Use user-specific wgetrc if both the config and HSTS cache exist
if [ -r "$HOME/.config/wget/wgetrc" ] && [ -r "$HOME/.cache/wget-hsts" ]; then
    WGETRC="$HOME/.config/wget/wgetrc"
    export WGETRC
fi
# )))

# )))

# ------------------- SSH Agent Setup -------------------(((
# Start ssh-agent if not already running and add a specific key
if command_type_exists ssh-agent && [ -z "$SSH_AUTH_SOCK" ]; then
    # Start ssh-agent silently
    eval "$(ssh-agent)" >/dev/null

    # Add a default SSH key, suppressing errors if the file doesn't exist
    ssh-add "$HOME/.ssh/id_ed25519_nov13_2025" 2>/dev/null
fi
# )))
