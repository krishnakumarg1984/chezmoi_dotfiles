# Command classifier (pure posix) (((
# Cache delimiter
cache_delim='|'

# Function to check if a string contains the delimiter (| or =)
contains_delim() {
    input="$1"
    delim="$2"
    while [ -n "$input" ]; do
        first_char="${input%"${input#?}"}"
        if [ "$first_char" = "$delim" ]; then
            return 0
        fi
        input="${input#?}"
    done
    return 1
}

# Trim spaces and tabs from both ends (POSIX version)
trim_spaces() {
    input="$1"
    while [ -n "$input" ] && { [ "${input%"${input#?}"}" = " " ] || [ "${input%"${input#?}"}" = "	" ]; }; do
        input="${input#?}"
    done
    while [ -n "$input" ] && { [ "${input%"${input#?}"}" = " " ] || [ "${input%"${input#?}"}" = "	" ]; }; do
        input="${input%?}"
    done
    printf '%s' "$input"
}

# Ensure valid command name (letters, numbers, underscores, periods, hyphens, plus signs allowed)
is_valid_command_name() {
    case $1 in
        ""|*[!A-Za-z0-9._\-+]*)
            return 1 ;;
    esac
    return 0
}

# Cache lookup - handle malformed or empty entries
cache_lookup() {
    cache="$1"
    name="$2"
    [ -z "$cache" ] && { printf 'not_found'; return 1; }

    rest="$cache"
    while [ -n "$rest" ]; do
        entry="${rest%%"$cache_delim"*}"
        rest="${rest#*"$cache_delim"}"

        # Skip empty or malformed entries
        if [ -z "$entry" ] || [ "${entry#*=}" = "$entry" ]; then
            continue
        fi

        key="${entry%%=*}"
        value="${entry#*=}"

        if [ -z "$key" ] || [ -z "$value" ]; then
            continue
        fi

        if [ "$key" = "$name" ]; then
            printf '%s' "$value"
            return 0
        fi
    done

    printf 'not_found'
    return 1
}

# Cache update - handle malformed or empty entries
cache_set() {
    cache="$1"
    name="$2"
    value="$3"
    [ -z "$value" ] && value="not_found"

    # Ensure no delimiter (| or =) in name or value
    if contains_delim "$name" "$cache_delim" || contains_delim "$name" "=" || contains_delim "$value" "$cache_delim" || contains_delim "$value" "="; then
        printf 'not_found'
        return 1
    fi

    new=""
    updated=0
    rest="$cache"

    if [ -z "$cache" ]; then
        new="${name}=${value}"
    else
        while [ -n "$rest" ]; do
            entry="${rest%%"$cache_delim"*}"
            rest="${rest#*"$cache_delim"}"
            if [ "${entry#*=}" != "$entry" ] && [ "${entry%%=*}" = "$name" ]; then
                new="${new}${name}=${value}${cache_delim}"
                updated=1
            elif [ -n "$entry" ]; then
                new="${new}${entry}${cache_delim}"
            fi
        done
        if [ "$updated" -eq 0 ]; then
            new="${new}${name}=${value}"
        else
            new="${new%"$cache_delim"}"  # Remove the trailing delimiter if updated
        fi
    fi

    # Remove any trailing | (to prevent malformed cache)
    printf '%s' "${new%"$cache_delim"}"
}

# Keyword detection (POSIX compliant, no external tools)
_is_keyword() {
    case $1 in
        '!'|'{'|'}'|case|do|done|elif|else|esac|fi|for|if|in|then|until|while )
            return 0 ;;
    esac
    return 1
}

# Special builtin detection (POSIX compliant, no external tools)
_is_special_builtin() {
    case $1 in
        :|.|break|continue|eval|exec|exit|export|readonly|return|set|shift|times|trap|umask|unset )
            return 0 ;;
    esac
    return 1
}

# Check if file is executable (POSIX)
_is_executable() {
    [ -f "$1" ] && [ -x "$1" ] && [ ! -d "$1" ]
}

# PATH search (POSIX)
_ct_find_in_path() {
    name="$1"
    oldIFS="$IFS"
    IFS=':'

    # Handle case where PATH might be empty or malformed
    [ -z "$PATH" ] && { IFS="$oldIFS"; return 1; }

    set -- $PATH
    [ "$#" -eq 0 ] && set -- "."

    for dir; do
        [ -z "$dir" ] || [ "$dir" = "." ] && continue
        f="$dir/$name"
        if [ -f "$f" ] && [ -x "$f" ] && [ ! -d "$f" ]; then
            printf '%s' "$f"
            IFS="$oldIFS"
            return 0
        fi
    done

    IFS="$oldIFS"
    return 1
}

# Main command type resolution
command_type() {
    local_cache="$1"
    name=$(trim_spaces "$2")

    # Validate command name
    if [ -z "$name" ] || ! is_valid_command_name "$name"; then
        printf 'not_found'
        return 1
    fi

    # Look up in cache
    result=$(cache_lookup "$local_cache" "$name")
    if [ "$result" != "not_found" ]; then
        printf '%s' "$result"
        return 0
    fi

    # Check if it's a shell keyword
    if _is_keyword "$name"; then
        local_cache=$(cache_set "$local_cache" "$name" "keyword")
        printf 'keyword'
        return 0
    fi

    # Check if it's a special builtin
    if _is_special_builtin "$name"; then
        local_cache=$(cache_set "$local_cache" "$name" "builtin")
        printf 'builtin'
        return 0
    fi

    # Check if it's executable
    if _is_executable "$name"; then
        local_cache=$(cache_set "$local_cache" "$name" "executable")
        printf 'executable'
        return 0
    fi

    # Check if it's in PATH
    if _ct_find_in_path "$name" >/dev/null; then
        local_cache=$(cache_set "$local_cache" "$name" "executable")
        printf 'executable'
        return 0
    fi

    # Not found in cache or PATH
    local_cache=$(cache_set "$local_cache" "$name" "not_found")
    printf 'not_found'
}

