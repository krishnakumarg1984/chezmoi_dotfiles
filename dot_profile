# Function: update_env_var (((
# Purpose:
#   This function modifies a colon-separated environment variable (e.g., PATH)
#   by performing operations like prepend, append, remove, movefirst, movelast.
#   It also handles deduplication by default to ensure no duplicate entries in the variable.
#
# Arguments:
#   $1 - (Required) The environment variable to modify (e.g., PATH).
#   $2 - (Optional) The operation to perform on the variable: prepend, append, movefirst, movelast, remove (default: deduplication).
#   $3 - (Required) The new entry to add, prepend, remove, or move.
#   $4 - (Optional) Custom delimiter to use for splitting the environment variable (default is colon ":").
#   $5 - (Optional) Flags: --verbose, -v (prints the updated variable after modification) or --quiet, -q (suppresses output).
#
# Returns:
#   - Updates the specified environment variable by modifying its value based on the specified operation.
#
# ============================================================
update_env_var() {
    # 1. **Determine if the shell is interactive or non-interactive**
    # ============================================================
    # The shell is interactive if:
    # - The PS1 variable is set (indicating an interactive terminal).
    # - The `-` flag contains "i" (indicating an interactive shell).
    if [ -n "$PS1" ] || [[ "$-" == *i* ]]; then
        verbose="yes"  # Interactive shell -> verbose mode
    else
        verbose="no"   # Non-interactive shell (e.g., sourcing a script) -> quiet mode by default
    fi

    # 2. **Initialize default values**
    # ============================================================
    var="$1"           # The environment variable to modify (e.g., PATH)
    operation="deduplicate"  # Default operation: deduplicate duplicates
    delimiter=":"      # Default delimiter is colon ":"
    entry=""           # The new entry to be modified/added to the environment variable
    quiet="no"         # Quiet mode flag (suppress output when set)

    # 3. **Parse the remaining arguments to configure the function's behavior**
    # ============================================================
    shift  # Shift off the first argument (var)

    while [ $# -gt 0 ]; do
        case "$1" in
            --verbose|-v) verbose="yes" ;;    # Verbose flag (prints output after operation)
            --quiet|-q) quiet="yes" ;;       # Quiet flag (suppresses output)
            prepend|append|movefirst|movelast|remove) operation="$1" ;;  # Operation flags
            --delimiter|-d) delimiter="$2"; shift ;;  # Custom delimiter flag, shift for the delimiter value
            *) entry="$1" ;;  # Entry to add, prepend, remove, or move
        esac
        shift  # Move to the next argument
    done

    # 4. **Default operation is deduplication if no entry is provided**
    # ============================================================
    if [ -z "$entry" ] && [ "$operation" != "remove" ]; then
        operation="deduplicate"  # If no entry is specified, deduplication is performed by default
    fi

    # 5. **Check if entry is required for non-deduplication operations**
    # ============================================================
    if [ -z "$entry" ] && [ "$operation" != "deduplicate" ]; then
        echo "Error: No entry specified to modify the variable." >&2
        return 1
    fi

    # 6. **Retrieve the current value of the environment variable**
    # ============================================================
    val="${!var}"  # Indirect variable expansion to get the value of the environment variable

    # If the variable is empty, set it to an empty string
    if [ -z "$val" ]; then
        val=""
    fi

    # 7. **Split the current value into an array using the delimiter**
    # ============================================================
    IFS="$delimiter" read -r -a entries <<< "$val"

    # 8. **Perform deduplication**
    # ============================================================
    seen=""  # String to track seen entries
    result=()  # Array to hold the deduplicated result

    for e in "${entries[@]}"; do
        # If the entry has already been seen, skip it.
        if echo "$seen" | grep -q "$delimiter$e$delimiter\|^$e$delimiter\|$delimiter$e$"; then
            continue
        fi
        result+=("$e")
        seen="$seen$delimiter$e"
    done

    # 9. **Handle remove operation**
    # ============================================================
    if [ "$operation" = "remove" ]; then
        found="no"
        result=()
        for e in "${entries[@]}"; do
            if [ "$e" != "$entry" ]; then
                result+=("$e")
            else
                found="yes"
            fi
        done

        if [ "$found" = "no" ]; then
            echo "Error: Entry '$entry' not found in $var." >&2
            return 1
        fi
    fi

    # 10. **Handle adding or moving the new entry**
    # ============================================================
    if [ -n "$entry" ]; then
        if echo "$seen" | grep -q "$delimiter$entry$delimiter\|^$entry$delimiter\|$delimiter$entry$"; then
            # If entry already exists, move it to the specified position
            if [ "$operation" = "movefirst" ]; then
                result=("$entry" "${result[@]/$entry}")
            elif [ "$operation" = "movelast" ]; then
                result=("${result[@]/$entry}" "$entry")
            fi
        else
            # If entry doesn't exist, perform prepend or append
            if [ "$operation" = "prepend" ]; then
                result=("$entry" "${result[@]}")
            elif [ "$operation" = "append" ]; then
                result+=("$entry")
            fi
        fi
    fi

    # 11. **Reassemble the variable and update it**
    # ============================================================
    new_value=$(IFS="$delimiter"; echo "${result[*]}")
    export "$var=$new_value"  # Update the environment variable

    # 12. **Handle quiet mode and verbose mode**
    # ============================================================
    if [ "$quiet" = "yes" ]; then
        return 0  # Suppress any output if quiet mode is enabled
    fi

    if [ "$verbose" = "yes" ]; then
        echo "$new_value"  # Print the updated environment variable if verbose mode is enabled
    fi
}

