# SSH Agent Setup -------------------(((
if command -v "ssh-agent" > /dev/null 2>&1; then

  # Space-separated list of keys we want loaded
  _ssh_keys_to_add="$HOME/.ssh/id_ed25519_nov13_2025 $HOME/.ssh/id_ed25519"

  # Strip out keys which do not exist
  _valid_ssh_keys_for_keychain=""
  for _key in $_ssh_keys_to_add; do
    if [ -f "$_key" ] && [ -f "$_key.pub" ]; then
      if [ -z "$_valid_ssh_keys_for_keychain" ]; then
        _valid_ssh_keys_for_keychain="$_key"
      else
        _valid_ssh_keys_for_keychain="$_valid_ssh_keys_for_keychain $_key"
      fi
    fi
  done
  _ssh_keys_to_add="$_valid_ssh_keys_for_keychain"
  unset _valid_ssh_keys_for_keychain _key

  # Prefer keychain if available, else fallback to ssh-agent + ssh-add
  if command -v "keychain" > /dev/null 2>&1; then

    eval "$(keychain --absolute --dir "$XDG_RUNTIME_DIR"/keychain \
      --confallhosts --ignore-missing --nogui --ssh-allow-forwarded --quiet --systemd \
      $_ssh_keys_to_add)"

  else

    # Start ssh-agent only if not already running
    [ -z "$SSH_AUTH_SOCK" ] && eval "$(ssh-agent -s)" >/dev/null

    # Add each valid key
    if command -v "ssh-add" > /dev/null 2>&1; then
      set -- $_ssh_keys_to_add
      while [ $# -gt 0 ]; do
        _current_ssh_key="$1"
        [ -f "$_current_ssh_key" ] && ssh-add "$_current_ssh_key" >/dev/null 2>&1
        shift
      done
    fi

  fi

  unset _ssh_keys_to_add

fi
# )))

