set postponed = "+Drafts"      # Start new email but then pause to continue later.
set mbox=+mbox  # based on Arch Wiki for outgoing mail; If you want to save (move) mails out of the inbox which you've read instead of deleting them right on (or cluttering up your inbox). Default mailbox.

