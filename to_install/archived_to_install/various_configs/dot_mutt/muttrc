## Paths
# set folder=~/Mail
set folder = "~/Mail/work_ucl_account"  # Note: do not end "folder" path with a "/", because mutt automatically inserts one when you use "=" or "+". An extra one would break some functionality because of "//". Typically you set "$folder" first and all its dependencies after that, this means: the order matters.
set mbox_type=Maildir                   # does not convert existing folders to MaildirFormat, it only creates new ones that way.
set spoolfile = "+INBOX"                # This is the startup folder assumed to contain all new email that arrives for you. https://gitlab.com/muttmua/mutt/-/wikis/MuttGuide/Folders
# set spoolfile=+/
# folder-hook work_ucl_account "set spoolfile="+INBOX""
set mask = no
# set mask=".*"    # the default mask hides dotfiles and maildirs are dotfiles now.
# set mask="!^\.[^.]"  # this line intentionally commented out
# set record = +$my_sent_noquote
set record = "+Sent Items"     # Sometimes it's good to keep a copy of sent out messages in case you need to resend them or verify discussions.
