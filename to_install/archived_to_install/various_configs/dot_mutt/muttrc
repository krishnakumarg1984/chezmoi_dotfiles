set index_format='%4C  (%?l?%4l&%4c?) %Z %<[y?%<[m?%<[d?%[      %H:%M ]&%[     %a %d ]>&%[%b %d,%Y ]>&%[%b %d,%Y ]> %-21.21L  %s'
