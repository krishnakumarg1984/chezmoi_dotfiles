# HTML
text/html; w3m -I %{charset} -F -dump -T text/html -cols 80 '%s'; copiousoutput; description=HTML Document; nametemplate=%s.html ;  test=type w3m >/dev/null
text/html; w3m -I %{charset} -F -dump -T text/html -cols 80 '%s'; copiousoutput; description=HTML Document; nametemplate=%s.html ;  test=type w3m >/dev/null
text/html; w3m -F -dump -T text/html -cols 80 %s description="HTML Document" ; nametemplate=%s.html ; copiousoutput; test=type w3m >/dev/null
text/html; w3m -I %{charset} -F -T text/html %s description="HTML Document" ; nametemplate=%s.html ; copiousoutput
text/html; html2text -width 70; copiousoutput; description=HTML Text; test=type html2text >/dev/null
text/html; elinks -dump %s -eval 'set document.codepage.assume = "%{charset}"' -eval 'set document.dump.width = 100'; nametemplate=%s.html; copiousoutput
text/html; lynx -assume_charset=%{charset} -display_charset=utf-8 -dump %s; nametemplate=%s.html; copiousoutput
text/html; mv %s %s.html && firefox %s.html > /dev/null; needsterminal;
text/html; pandoc -f html -t markdown; copiousoutput; description=HTML Text; test=type pandoc >/dev/null
text/html; uconv --add-signature -f %{charset} -t UTF-8 %s | sponge %s && firefox -new-tab %s & sleep 5 ; description="HTML Document" ; test=test -n "$DISPLAY" ; nametemplate=%s.html
