# shellcheck disable=1091,2148

# echo "from .bash_profile"

# Activate mise
command -v mise &>/dev/null && source <(mise activate bash --shims)

# Source ~/.profile (which contains common settings across shells e.g. environment variables)
[[ -f $HOME/.profile ]] && source "$HOME/.profile"

# ((( Source ~/.bashrc (if present) to have aliases/functions etc defined for login shell sessions also
# Most bash settings are in ~/.bashrc file to consolidate settings in one place ~/.bashrc
# https://superuser.com/questions/183870/difference-between-bashrc-and-bash-profile/183980
if [[ "$-" == *i* && -f "$HOME/.bashrc" ]]; then
  # If starship is installed & using WezTerm, start a new interactive Bash shell to get the prompt
  if command -v starship &>/dev/null && [[ "$TERM_PROGRAM" == "WezTerm" ]]; then
    # echo "Spawing a new subshell for starship & wezterm"
    bash --rcfile "$HOME/.bashrc"
  else
    # echo "Sourcing ~/.bashrc without spawning a new subshell"
    source "$HOME/.bashrc"
  fi
fi
