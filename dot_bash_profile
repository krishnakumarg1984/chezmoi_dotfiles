# esac
# )))

# echo "In ~/.bash_profile: PATH at the end of ~/.bash_profile: "
# echo $PATH | tr ":" "\n" | grep -E "^/home"

[[ -n "$BASH_PROFILE_DEBUG" ]] && echo "End of ~/.bash_profile"

