MAMBA_EXE="$(command -v micromamba)"
if [ -x "$MAMBA_EXE" ]; then
  # >>> mamba initialize >>>
  # !! Contents within this block are managed by 'mamba init' !!
  export MAMBA_EXE
  export MAMBA_ROOT_PREFIX="$(dirname "$(dirname "$MAMBA_EXE")")"
  __mamba_setup="$("$MAMBA_EXE" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null)"
  # echo $__mamba_setup
  if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
  else
    alias micromamba="$MAMBA_EXE" # Fallback on help from mamba activate
  fi
  unset __mamba_setup
  alias mamba='micromamba' && alias conda='mamba'
  # <<< mamba initialize <<<
  mamba activate mambaenv_base 2>/dev/null
fi

