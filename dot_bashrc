# ----- bash-completion system files ----- (((
for bc in \
  "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" \
  /usr/share/bash-completion/bash_completion \
  /etc/bash_completion; do
if [[ -r "$bc" ]]; then
  # Lazy-load bash-completion on first completion attempt
  __lazy_completion_file__default="$bc"

    # Only attach default dispatcher if no default completions exist yet
    if ! complete -p -D &>/dev/null; then
      # Guarded default dispatcher
      __lazy_default_dispatcher() {
        # Only run if command has no completion
        local cmd=$1
        [[ -n $cmd ]] || return
        if ! complete -p "$cmd" &>/dev/null; then
          __lazy_source_completion_dispatch "$cmd"
        fi
      }
    complete -D -F __lazy_default_dispatcher
    fi
    break
fi
done
