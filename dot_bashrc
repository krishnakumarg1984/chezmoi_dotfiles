# Git-aware Bash prompt (((
  # --- Terminal color detection ---
  color_mode=
  if [[ "$COLORTERM" == *truecolor* ]] || [[ "$TERM" == *-truecolor* ]]; then
    color_mode=24bit
  elif [[ "$TERM" == *-256color ]] || [[ "$TERM" == screen* ]] || [[ "$TERM" == tmux* ]]; then
    color_mode=256
  elif [[ "$TERM" == xterm* || "$TERM" == rxvt* ]]; then
    color_mode=16
  fi
  [[ -n $force_color_prompt ]] && color_mode=${color_mode:-16}

# --- Color definitions ---
case $color_mode in
  24bit)
    RED="\[\033[38;2;255;50;50m\]"
    GREEN="\[\033[38;2;50;255;50m\]"
    ORANGE="\[\033[38;2;255;165;0m\]"
    BLUE="\[\033[38;2;100;149;237m\]"
    MAGENTA="\[\033[38;2;200;100;255m\]"
    BOLD="\[\033[1m\]"
    RESET="\[\033[0m\]"
    ;;
  256)
    RED="\[\033[38;5;196m\]"
    GREEN="\[\033[38;5;82m\]"
    ORANGE="\[\033[38;5;208m\]"
    BLUE="\[\033[38;5;75m\]"
    MAGENTA="\[\033[38;5;141m\]"
    BOLD="\[\033[1m\]"
    RESET="\[\033[0m\]"
    ;;
  16)
    RED="\[\033[31m\]"
    GREEN="\[\033[32m\]"
    ORANGE="\[\033[33m\]"
    BLUE="\[\033[34m\]"
    MAGENTA="\[\033[35m\]"
    BOLD="\[\033[1m\]"
    RESET="\[\033[0m\]"
    ;;
esac

# --- Git prompt cache ---
GIT_PROMPT_CACHE=""
GIT_PROMPT_DIR=""

precompute_git_prompt() {
  local dir="$PWD"
  if [[ "$dir" != "$GIT_PROMPT_DIR" ]]; then
    if git rev-parse --is-inside-work-tree &>/dev/null; then
      local gitdir branch icon dirty untracked stash ahead behind upstream
      gitdir=$(git rev-parse --git-dir 2>/dev/null) || return

      # Branch
      read -r ref < "$gitdir/HEAD"
      branch="${ref#ref: refs/heads/}"
      [[ -z $branch ]] && branch="DETACHED"

      # Status
      local dirty_flag untracked_flag
      while IFS= read -r line; do
        case "$line" in
          "??"*) untracked_flag=1 ;;
          [ADMRC]??*) dirty_flag=1 ;;
        esac
      done < <(git status --porcelain -uno 2>/dev/null)

      [[ $dirty_flag ]] && { dirty="*"; icon="🔴"; } || icon="🟢"
      [[ $untracked_flag ]] && untracked="❓"

      # Upstream
      local ahead_count behind_count
      read -r ahead_count behind_count < <(git rev-list --left-right --count @{upstream}...HEAD 2>/dev/null || echo 0 0)
      [[ $ahead_count -gt 0 ]] && upstream+="${GREEN}↑${ahead_count}${RESET}"
      [[ $behind_count -gt 0 ]] && upstream+="${RED}↓${behind_count}${RESET}"

      # Stash
      local stash_count
      stash_count=$(git rev-parse --verify refs/stash 2>/dev/null && git stash list 2>/dev/null | wc -l)
      [[ $stash_count -gt 0 ]] && stash="⚑${stash_count}"

      GIT_PROMPT_CACHE="[${icon}${branch}${dirty}${untracked}${upstream}${stash}]"
    else
      GIT_PROMPT_CACHE=""
    fi
    GIT_PROMPT_DIR="$dir"
  fi
}

# Shorten path helper
shorten_path() {
  local path="$PWD"
  [[ "$path" == "$HOME"* ]] && path="~${path#$HOME}"
  local base="${path##*/}"
  [[ "$path" =~ "/" ]] && path="…/${base}"
  echo -n "$path"
}

# Construct PS1
PS1="${GREEN}\u${RESET}@${ORANGE}\h${RESET}: {${BLUE}\$(shorten_path)${RESET}\${GIT_PROMPT_CACHE}}\n${BOLD}\$${RESET} "

# Terminal title
case "$TERM" in
  xterm*|rxvt*|screen*|tmux*)
    PS1="\[\e]0;\u@\h: \w\a\]$PS1"
    ;;
esac

# Update Git prompt before each display
PROMPT_COMMAND="precompute_git_prompt"

