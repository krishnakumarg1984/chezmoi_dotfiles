# export PROMPT_COMMAND='history -a; history -n' # By default, bash only records a session to the .bash_history file on disk when the session terminates. This means that if you crash or your session terminates improperly, you lose the history up to that point. You can fix this by recording each line of history as you issue it, through the PROMPT_COMMAND variable.
__history_sync() {
  builtin history -a
  builtin history -n
}

[[ -n $PS1 ]] && case ";$PROMPT_COMMAND;" in
  *";__history_sync;"*) ;;
  *) PROMPT_COMMAND="__history_sync${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac
