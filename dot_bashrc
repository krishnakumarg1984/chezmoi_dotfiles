# Completions from the `bash-completions` package & other third-party tools (((

# Helper to lazily source a completion file for a command (((
# Usage: __lazy_source_completion <cmd> <completion_file>
__lazy_source_completion() {
  local cmd=$1 file=$2 var
  [[ $cmd =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || return
  [[ -r $file ]] || return

  var="__lazy_completion_file_${cmd}"
  printf -v "$var" '%s' "$file"

  # Attach dispatcher once
  local flag="__lazy_completion_attached_$cmd"
  [[ ${!flag-} ]] && return
  complete -F __lazy_source_completion_dispatch -- "$cmd"
  printf -v "$flag" 1
}

# Dispatcher: invoked once when user requests completion
__lazy_source_completion_dispatch() {
  local cmd=$1 var file old_COMPREPLY
  [[ -z $cmd ]] && return
  var="__lazy_completion_file_$cmd"
  file=${!var-}
  [[ -r $file ]] || file=${__lazy_completion_file__default-}
  [[ -r $file ]] || return

  old_COMPREPLY=("${COMPREPLY[@]}")
  COMPREPLY=()

  source "$file" 2>/dev/null || true

  [[ $(type -t "${cmd}_completion") == function ]] && "${cmd}_completion"

  [[ ${#COMPREPLY[@]} -eq 0 ]] && COMPREPLY=("${old_COMPREPLY[@]}")

  complete -r "$cmd" 2>/dev/null
  unset "$var" old_COMPREPLY
  }
