# vim: ft=sshconfig

Host devcloud_old
    # User u128252
    # IdentityFile ~/.ssh/devcloud-access-key-128252.txt
    # ProxyCommand ssh -T -i ~/.ssh/devcloud-access-key-128252.txt guest@ssh.devcloud.intel.com
    User u130758
    IdentityFile ~/.ssh/devcloud-access-key-130758.txt
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking no
    ProxyCommand ssh -T -i ~/.ssh/devcloud-access-key-130758.txt guest@ssh.devcloud.intel.com

Host devcloud.proxy_old
    # User u128252
    Port 4022
    IdentityFile ~/.ssh/devcloud-access-key-130758.txt
    ProxyCommand ssh -T devcloud-via-proxy

# If you must route outgoing SSH connection via a corporate proxy,
# replace PROXY_HOSTNAME and PORT below with the values provided by
# your network administrator.
Host devcloud-via-proxy_old
    User guest
    Hostname ssh.devcloud.intel.com
    IdentityFile ~/.ssh/devcloud-access-key-128252.txt
    LocalForward 4022 c009:22
    ProxyCommand nc -x PROXY_HOSTNAME:PORT %h %p

